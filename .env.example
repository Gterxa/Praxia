# Supabase del formulario de /validar. Proyecto "earlykapital", schema praxia_leads.
# La anon key solo puede insertar en praxia_leads.leads (política RLS) — segura para
# exponerse en el cliente.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# GoHighLevel (CRM del funnel /funnel). Llave de una Private Integration de la
# subcuenta Praxia. SOLO servidor: va en Vercel como variable secreta, nunca PUBLIC_.
GHL_TOKEN=

# Medición (ver src/analitica.ts). Públicas: viajan al navegador. Si una falta,
# esa herramienta no se carga y su dominio no entra en la CSP. Se leen en el
# build: después de cambiarlas en Vercel hay que redeplegar.
# Google Analytics 4: G-XXXXXXXXXX
PUBLIC_GA4_ID=
# Píxel de Meta: solo números
PUBLIC_META_PIXEL_ID=
# Microsoft Clarity: unas 10 letras y números
PUBLIC_CLARITY_ID=
