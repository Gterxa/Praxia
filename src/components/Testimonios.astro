---
/**
 * Carrusel de testimonios. Con TESTIMONIOS vacío muestra seis citas de muestra
 * marcadas como pendientes, solo con MOSTRAR_PENDIENTES en `true`. Nunca sale
 * a producción con contenido inventado: la home lo condiciona a HAY_PRUEBA_SOCIAL.
 */
import Marquee from './Marquee.astro';
import { TESTIMONIOS } from '../consts';

const hayReales = TESTIMONIOS.length > 0;

const MUESTRA = [
  { cita: 'Cita de muestra: dos líneas sobre qué cambió en el negocio.', nombre: 'Nombre Apellido', rubro: 'Rubro' },
  { cita: 'Cita de muestra: una frase corta y concreta.', nombre: 'Nombre Apellido', rubro: 'Rubro' },
  { cita: 'Cita de muestra: qué automatizaron y cuánto tiempo recuperaron.', nombre: 'Nombre Apellido', rubro: 'Rubro' },
  { cita: 'Cita de muestra: por qué eligieron a Praxia.', nombre: 'Nombre Apellido', rubro: 'Rubro' },
  { cita: 'Cita de muestra: qué pasó después del lanzamiento.', nombre: 'Nombre Apellido', rubro: 'Rubro' },
  { cita: 'Cita de muestra: una recomendación directa.', nombre: 'Nombre Apellido', rubro: 'Rubro' },
];

const items = hayReales ? TESTIMONIOS : MUESTRA;
---

<section class="border-y border-linea bg-void py-12 md:py-16" aria-label="Testimonios de clientes">
  <p class="mono text-center text-texto-3">Lo que dicen quienes ya automatizaron</p>

  <div class="mt-8">
    <Marquee velocidad={70}>
      {
        items.map((t) => (
          <li class="w-80 flex-none">
            <figure class="tarjeta flex h-full flex-col justify-between gap-5">
              <blockquote class="text-texto">
                {hayReales ? <p>«{t.cita}»</p> : <p><span class="pendiente">{t.cita}</span></p>}
              </blockquote>
              <figcaption class="pequeno text-texto-2">
                {hayReales ? (
                  <>
                    <span class="font-medium text-texto">{t.nombre}</span> · {t.rubro}
                  </>
                ) : (
                  <span class="pendiente">
                    {t.nombre} · {t.rubro}
                  </span>
                )}
              </figcaption>
            </figure>
          </li>
        ))
      }
    </Marquee>
  </div>
</section>
