---
import Icon from './Icon.astro';

interface Props {
  ejemplos: readonly string[];
}
const { ejemplos } = Astro.props;
---

<ul class="grid gap-4 sm:grid-cols-2">
  {
    ejemplos.map((ejemplo) => (
      <li class="tarjeta flex gap-3.5">
        <span class="mt-1 flex-none text-arcilla-700">
          <Icon nombre="flecha" tamano={18} />
        </span>
        <span class="text-tinta">{ejemplo}</span>
      </li>
    ))
  }
</ul>
