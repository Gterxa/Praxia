---
interface Props {
  /** Fondo de la sección. */
  fondo?: 'void' | 'surface' | 'acento';
  id?: string;
  class?: string;
}
const { fondo = 'void', id, class: clase = '' } = Astro.props;

const fondos = {
  void: 'bg-void',
  surface: 'bg-surface border-y border-linea',
  acento: 'bg-surface',
} as const;
---

<section id={id} class:list={['seccion', fondos[fondo], clase]}>
  <div class="contenedor">
    <slot />
  </div>
</section>
