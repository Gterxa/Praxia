---
interface Props {
  /** Fondo de la sección. */
  fondo?: 'void' | 'surface' | 'acento';
  id?: string;
  class?: string;
}
const { fondo = 'void', id, class: clase = '' } = Astro.props;

const fondos = {
  // Transparente a propósito: deja ver el fondo global negro (FondoOrbes).
  // Las tres variantes comparten el mismo negro absoluto: "surface" y
  // "acento" solo aportaban gris antes, ahora únicamente marcan el límite
  // de sección con una línea.
  void: '',
  surface: 'border-y border-linea',
  acento: '',
} as const;

/** Con slot "aside", el contenido va en dos columnas y el aside se pega al scroll. */
const tieneAside = Astro.slots.has('aside');
---

<section id={id} class:list={['seccion', fondos[fondo], clase]}>
  <div class="contenedor">
    {
      tieneAside ? (
        <div class="grid gap-10 lg:grid-cols-[1fr_22rem] lg:gap-16">
          <div class="min-w-0">
            <slot />
          </div>
          <div class="lg:sticky lg:top-28 lg:self-start">
            <slot name="aside" />
          </div>
        </div>
      ) : (
        <slot />
      )
    }
  </div>
</section>
