---
/**
 * Conversación de WhatsApp simulada, en HTML y CSS. Sin imágenes ni capturas.
 *
 * Es el "screenshot de producto" de Praxia: el comprador vive en WhatsApp, así
 * que mostrar la automatización funcionando es mostrar un chat.
 *
 * El contenido viene del markdown de cada capacidad (campo `conversacion`).
 * Ver CONTENIDO.md para editarlas.
 */
interface Props {
  negocio: string;
  mensajes: readonly { de: 'cliente' | 'negocio'; texto: string; hora: string }[];
  class?: string;
}

const { negocio, mensajes, class: clase = '' } = Astro.props;

/** Iniciales para el avatar del encabezado. */
const iniciales = negocio
  .split(' ')
  .filter((p) => p.length > 2)
  .slice(0, 2)
  .map((p) => p[0])
  .join('')
  .toUpperCase();
---

<figure class:list={['chat', clase]}>
  <div class="chat-marco">
    <div class="chat-encabezado">
      <span class="chat-avatar" aria-hidden="true">{iniciales}</span>
      <span class="chat-identidad">
        <span class="chat-negocio">{negocio}</span>
        <span class="chat-estado">en línea</span>
      </span>
      <span class="chat-etiqueta">Ejemplo</span>
    </div>

    <ol class="chat-cuerpo">
      {
        mensajes.map((m) => (
          <li class:list={['chat-fila', m.de === 'negocio' && 'es-negocio']}>
            <div class="chat-burbuja">
              <span class="sr-only">{m.de === 'negocio' ? `${negocio}:` : 'Cliente:'}</span>
              <p class="chat-texto" set:html={m.texto.replace(/\n/g, '<br />')} />
              <span class="chat-meta">
                <span class="chat-hora">{m.hora}</span>
                {m.de === 'negocio' && (
                  <svg
                    class="chat-checks"
                    viewBox="0 0 18 12"
                    width="16"
                    height="11"
                    aria-hidden="true"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M1 6.6 4.1 9.8 10.4 2.2" />
                    <path d="M7.2 6.6 10.3 9.8 16.6 2.2" />
                  </svg>
                )}
              </span>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
  <figcaption class="sr-only">
    Ejemplo de una conversación automatizada por WhatsApp con {negocio}, un negocio ficticio.
  </figcaption>
</figure>

<style>
  .chat {
    --chat-fondo: #ece7df;
    --chat-cliente: #ffffff;
    --chat-negocio: #d8eddf;
    width: 100%;
    max-width: 24rem;
    margin: 0;
  }

  .chat-marco {
    overflow: hidden;
    border: 1px solid var(--color-gris-200);
    border-radius: 1.25rem;
    background: var(--chat-fondo);
    box-shadow:
      0 1px 2px rgb(26 35 50 / 0.06),
      0 12px 28px -12px rgb(26 35 50 / 0.22);
  }

  /* --- Encabezado --- */
  .chat-encabezado {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.75rem 0.875rem;
    background: var(--color-tinta);
    color: var(--color-hueso);
  }

  .chat-avatar {
    display: grid;
    place-items: center;
    flex: none;
    width: 2.125rem;
    height: 2.125rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-hueso) 18%, transparent);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .chat-identidad {
    display: flex;
    min-width: 0;
    flex-direction: column;
    line-height: 1.25;
  }

  .chat-negocio {
    font-size: 0.9375rem;
    font-weight: 600;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .chat-estado {
    font-size: 0.75rem;
    color: var(--color-gris-200);
  }

  .chat-etiqueta {
    margin-left: auto;
    flex: none;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-hueso) 16%, transparent);
    padding: 0.1875rem 0.5rem;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-gris-200);
  }

  /* --- Mensajes --- */
  .chat-cuerpo {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin: 0;
    padding: 1rem 0.875rem 1.125rem;
    list-style: none;
  }

  .chat-fila {
    display: flex;
    justify-content: flex-start;
  }

  .chat-fila.es-negocio {
    justify-content: flex-end;
  }

  .chat-burbuja {
    position: relative;
    max-width: 86%;
    border-radius: 0.875rem 0.875rem 0.875rem 0.25rem;
    background: var(--chat-cliente);
    padding: 0.5rem 0.6875rem 0.4375rem;
    box-shadow: 0 1px 1px rgb(26 35 50 / 0.08);
  }

  .es-negocio .chat-burbuja {
    border-radius: 0.875rem 0.875rem 0.25rem 0.875rem;
    background: var(--chat-negocio);
  }

  .chat-texto {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.45;
    color: var(--color-tinta);
    white-space: pre-line;
  }

  .chat-meta {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.25rem;
    margin-top: 0.125rem;
    color: var(--color-gris-600);
  }

  .chat-hora {
    font-size: 0.6875rem;
    line-height: 1;
  }

  .chat-checks {
    flex: none;
    color: var(--color-verde);
  }

  @media (min-width: 48rem) {
    .chat-texto {
      font-size: 0.9375rem;
    }
  }
</style>
