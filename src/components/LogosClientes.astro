---
/**
 * Franja de logos de clientes. Sin clientes en CLIENTES, muestra seis rubros de
 * ejemplo marcados como pendientes: solo se ven con MOSTRAR_PENDIENTES en `true`.
 */
import Marquee from './Marquee.astro';
import { CLIENTES, MOSTRAR_PENDIENTES } from '../consts';

const hayClientes = CLIENTES.length > 0;
const mostrar = hayClientes || MOSTRAR_PENDIENTES;

const MUESTRA = [
  'Veterinaria',
  'Inmobiliaria',
  'Estudio contable',
  'Clínica dental',
  'Academia',
  'Ferretería',
];
---

{
  mostrar && (
    <section class="py-10 md:py-12" aria-label="Clientes de Praxia">
      <div>
        <Marquee>
          {hayClientes
            ? CLIENTES.map((c) => {
                const contenido = c.logo ? (
                  <img
                    src={c.logo}
                    alt={c.nombre}
                    width={c.ancho}
                    height={c.alto}
                    loading="lazy"
                    class="logo-suelto grayscale transition-[filter] duration-300 group-hover:grayscale-0"
                  />
                ) : (
                  <span class="font-[family-name:var(--font-titulos)] font-semibold text-texto-3 transition-colors duration-300 group-hover:text-texto">
                    {c.nombre}
                  </span>
                );
                return (
                  <li class="flex flex-col items-center gap-1.5">
                    {c.url ? (
                      <a href={c.url} target="_blank" rel="noopener" class="group">
                        {contenido}
                      </a>
                    ) : (
                      <span class="group">{contenido}</span>
                    )}
                    <span class="pequeno text-texto-3 md:sr-only" aria-hidden="true">
                      {c.nombre}
                    </span>
                  </li>
                );
              })
            : MUESTRA.map((rubro) => (
                <li class="flex flex-col items-center gap-1.5">
                  <span class="pendiente flex h-12 items-center">{rubro}</span>
                </li>
              ))}
        </Marquee>
      </div>
    </section>
  )
}

<style is:global>
  .logo-suelto {
    display: block;
    height: 2.75rem;
    width: auto;
    max-width: 9rem;
    object-fit: contain;
  }
</style>
