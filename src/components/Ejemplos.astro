---
import Seccion from './Seccion.astro';
import CabeceraSeccion from './CabeceraSeccion.astro';
import { EJEMPLOS } from '../ejemplos';

interface Props {
  /** true en /casos: sin encabezado propio (la página ya trae su Hero). */
  soloTarjetas?: boolean;
}
const { soloTarjetas = false } = Astro.props;
---

<Seccion id="ejemplos" class={!soloTarjetas ? 'seccion-cosmoq' : undefined}>
  {
    soloTarjetas ? (
      <div class="grid gap-4 md:grid-cols-3">
        {
          EJEMPLOS.map((e, i) => (
            <article class="tarjeta revelar" data-retraso={String(Math.min(3, i + 1))}>
              <span class="chip-mono">Ejemplo ilustrativo</span>
              <h3 class="mt-4 text-[1.0625rem] font-semibold text-texto">{e.nombre}</h3>
              <p class="mt-2 text-[0.9375rem] text-texto-2">{e.situacion}</p>
              <dl class="mt-5 flex items-center justify-between border-t border-linea pt-4">
                <div>
                  <dt class="pequeno text-texto-3">Plazo</dt>
                  <dd class="text-[0.9375rem] font-medium text-texto">{e.plazo}</dd>
                </div>
                <div class="text-right">
                  <dt class="pequeno text-texto-3">Incluye</dt>
                  <dd class="text-[0.9375rem] font-medium text-texto">{e.incluye}</dd>
                </div>
              </dl>
            </article>
          ))
        }
      </div>
    ) : (
      <Fragment>
        <CabeceraSeccion etiqueta="Ejemplos" icono="contenido">
          <h2 slot="titulo" class="revelar" data-retraso="1">
            Así se ve un proyecto típico
          </h2>
          <p slot="subtitulo" class="lead text-texto-2 revelar" data-retraso="2">
            Casos ilustrativos para que dimensiones alcance y plazo. No son clientes reales.
          </p>
        </CabeceraSeccion>

        <div class="features__content mt-10" data-features>
          <nav class="features__nav" aria-label="Ejemplos">
            {
              EJEMPLOS.map((e, i) => (
                <button
                  type="button"
                  class:list={['ftag', i === 0 && 'is-active']}
                  data-target={`ejemplo-${i}`}
                  aria-current={i === 0 ? 'true' : 'false'}
                >
                  {e.nombre}
                  <span class="ftag__line" aria-hidden="true" />
                </button>
              ))
            }
          </nav>

          <div class="features__screens">
            {
              EJEMPLOS.map((e, i) => (
                <article
                  id={`ejemplo-${i}`}
                  class="scard revelar revelar-x"
                  data-retraso={String(Math.min(3, i + 1))}
                >
                  <div class="scard__content">
                    <div class="scard__title">
                      <h4>{e.nombre}</h4>
                      <p>{e.situacion}</p>
                    </div>
                    <dl class="scard__datos">
                      <div>
                        <dt class="pequeno text-texto-3">Plazo</dt>
                        <dd class="mt-1.5 text-[0.9375rem] font-medium text-texto">{e.plazo}</dd>
                      </div>
                      <div>
                        <dt class="pequeno text-texto-3">Incluye</dt>
                        <dd class="mt-1.5 text-[0.9375rem] font-medium text-texto">{e.incluye}</dd>
                      </div>
                    </dl>
                  </div>
                  <div class="scard__visual" aria-hidden="true">
                    <span class="chip-mono scard__chip">Ejemplo ilustrativo</span>
                  </div>
                </article>
              ))
            }
          </div>
        </div>
      </Fragment>
    )
  }
</Seccion>

<style>
  /* --- Nav sticky + tarjetas "scard" (patrón "features" de cosmoq). Solo se
     monta en la rama !soloTarjetas: en /casos (soloTarjetas) el grid de
     tarjetas simple no usa nada de esto. --- */
  .features__content {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    width: 100%;
  }

  @media (min-width: 64rem) {
    .features__content {
      flex-direction: row;
      justify-content: center;
      gap: 4rem;
    }
  }

  .features__nav {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    gap: 0.5rem;
    width: 100%;
  }

  @media (min-width: 64rem) {
    .features__nav {
      position: sticky;
      /* Alto real del header (Header.astro) + aire, no un número adivinado. */
      top: calc(var(--alto-header) + 1.5rem);
      align-self: flex-start;
      flex-direction: column;
      flex-wrap: nowrap;
      gap: 0;
      width: 15.75rem;
      flex: none;
    }
  }

  /* Pestaña de nav: opacidad como estado (no color, cosmoq) + línea inferior
     que se llena con la rampa cálida (--degradado-calido está documentado en
     tokens.css justo para "línea de progreso", que es lo que es esto). */
  .ftag {
    position: relative;
    display: flex;
    align-items: center;
    width: auto;
    padding: 0.875rem 0.75rem;
    border: none;
    background: transparent;
    opacity: 0.55;
    cursor: pointer;
    font-family: var(--font-titulos);
    font-size: 0.9375rem;
    line-height: 1.3;
    text-align: left;
    color: var(--color-texto);
    transition:
      opacity 350ms var(--ease-suave),
      transform 150ms var(--ease-resorte);
  }

  @media (min-width: 64rem) {
    .ftag {
      width: 100%;
    }
  }

  .ftag:hover,
  .ftag.is-active {
    opacity: 1;
  }

  .ftag:focus-visible {
    outline: 2px solid var(--color-brasa);
    outline-offset: 2px;
  }

  .ftag:active {
    transform: scale(0.98);
  }

  .ftag__line {
    position: absolute;
    left: 0.75rem;
    right: 0.75rem;
    bottom: 0;
    height: 1px;
    background: var(--color-linea);
    overflow: hidden;
  }

  .ftag__line::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--degradado-calido);
    transform: translateX(-101%);
    transition: transform 600ms var(--ease-resorte);
  }

  .ftag.is-active .ftag__line::after {
    transform: translateX(0);
  }

  .features__screens {
    display: flex;
    flex-direction: column;
    gap: 3rem;
    flex: 1 0 0;
    min-width: 0;
  }

  .scard {
    position: relative;
    display: flex;
    flex-direction: column;
    width: 100%;
    background: var(--color-surface);
    border-radius: var(--radius-tarjeta);
    overflow: hidden;
    /* Deja aire bajo el header cuando el nav hace scrollIntoView. */
    scroll-margin-top: calc(var(--alto-header) + 1.5rem);
  }

  @media (min-width: 64rem) {
    .scard {
      flex-direction: row;
      align-items: stretch;
      min-height: 22rem;
    }
  }

  .scard::after {
    content: '';
    position: absolute;
    inset: 0;
    /* --line de cosmoq → linea-viva al 16%, igual que CabeceraSeccion. */
    border: 1px solid rgb(84 124 255 / 0.16);
    border-radius: inherit;
    pointer-events: none;
  }

  .scard__content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 1.75rem;
    flex: 1 0 0;
    padding: 1.75rem;
    min-width: 0;
  }

  .scard__title h4 {
    font-family: var(--font-titulos);
    font-weight: 500;
    font-size: 1.5rem;
    line-height: 1.25;
    letter-spacing: -0.02em;
    color: var(--color-texto);
  }

  .scard__title p {
    margin-top: 0.625rem;
    max-width: 26rem;
    font-family: var(--font-cuerpo);
    font-size: 1.0625rem;
    line-height: 1.65;
    color: var(--color-texto-2);
  }

  .scard__datos {
    display: flex;
    gap: 2rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-linea);
  }

  /* Sin captura real de cada ejemplo: panel de relleno con la rampa
     atardecer a baja opacidad + el chip-mono agrandado, como pidió la tarea. */
  .scard__visual {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: 100%;
    min-height: 7rem;
    padding: 1.5rem;
    overflow: hidden;
    isolation: isolate;
  }

  .scard__visual::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--degradado-atardecer);
    opacity: 0.16;
  }

  @media (min-width: 64rem) {
    .scard__visual {
      width: 14rem;
      border-left: 1px solid var(--color-linea);
    }
  }

  .scard__chip {
    padding: 0.75rem 1.25rem;
    font-size: 0.8125rem;
  }
</style>

<script>
  // Nav sticky de Ejemplos: click hace scroll suave al scard, y un
  // IntersectionObserver marca is-active cuando el scard cruza el centro
  // del viewport (banda -45%/-45%), igual que la sincronización de cosmoq.
  document.querySelectorAll<HTMLElement>('[data-features]').forEach((grupo) => {
    const tags = Array.from(grupo.querySelectorAll<HTMLButtonElement>('.ftag'));
    const tarjetas = tags
      .map((tag) => document.getElementById(tag.dataset['target'] ?? ''))
      .filter((el): el is HTMLElement => el !== null);

    const marcar = (indice: number) => {
      tags.forEach((tag, i) => {
        const activa = i === indice;
        tag.classList.toggle('is-active', activa);
        tag.setAttribute('aria-current', String(activa));
      });
    };

    tags.forEach((tag, i) => {
      tag.addEventListener('click', () => {
        tarjetas[i]?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    });

    if ('IntersectionObserver' in window && tarjetas.length > 0) {
      const observador = new IntersectionObserver(
        (entradas) => {
          entradas.forEach((entrada) => {
            if (!entrada.isIntersecting) return;
            const indice = tarjetas.indexOf(entrada.target as HTMLElement);
            if (indice !== -1) marcar(indice);
          });
        },
        { rootMargin: '-45% 0px -45% 0px', threshold: 0 },
      );
      tarjetas.forEach((tarjeta) => observador.observe(tarjeta));
    }
  });
</script>
