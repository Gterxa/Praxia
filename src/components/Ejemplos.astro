---
import Seccion from './Seccion.astro';
import SectionLabel from './SectionLabel.astro';
import { EJEMPLOS } from '../ejemplos';

interface Props {
  /** true en /casos: sin encabezado propio (la página ya trae su Hero). */
  soloTarjetas?: boolean;
}
const { soloTarjetas = false } = Astro.props;
---

<Seccion id="ejemplos">
  {
    !soloTarjetas && (
      <>
        <SectionLabel texto="Ejemplos" />
        <h2 class="mt-3 max-w-xl revelar" data-retraso="1">Así se ve un proyecto típico</h2>
        <p class="lead mt-5 max-w-xl text-texto-2 revelar" data-retraso="2">
          Casos ilustrativos para que dimensiones alcance y plazo. No son clientes reales.
        </p>
      </>
    )
  }

  <div class="mt-10 grid gap-4 md:grid-cols-3">
    {
      EJEMPLOS.map((e, i) => (
        <article class="tarjeta revelar" data-retraso={String(Math.min(3, i + 1))}>
          <span class="chip-mono">Ejemplo ilustrativo</span>
          <h3 class="mt-4 text-[1.0625rem] font-semibold text-texto">{e.nombre}</h3>
          <p class="mt-2 text-[0.9375rem] text-texto-2">{e.situacion}</p>
          <dl class="mt-5 flex items-center justify-between border-t border-linea pt-4">
            <div>
              <dt class="pequeno text-texto-3">Plazo</dt>
              <dd class="text-[0.9375rem] font-medium text-texto">{e.plazo}</dd>
            </div>
            <div class="text-right">
              <dt class="pequeno text-texto-3">Incluye</dt>
              <dd class="text-[0.9375rem] font-medium text-texto">{e.incluye}</dd>
            </div>
          </dl>
        </article>
      ))
    }
  </div>
</Seccion>
