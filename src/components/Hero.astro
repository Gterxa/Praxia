---
import Icon from './Icon.astro';
import SectionLabel from './SectionLabel.astro';
import { waLink } from '../consts';

interface Props {
  antetitulo?: string;
  titulo: string;
  subtitulo: string;
  /** Línea chica de refuerzo debajo de los botones. */
  refuerzo?: string;
  ctaPrimario?: { texto: string; href: string };
  /** Si se pasa, el segundo botón abre WhatsApp con este mensaje. */
  contextoWhatsApp?: string;
}

/** Si se pasa algo al slot "visual", el hero se parte en dos columnas. */
const tieneVisual = Astro.slots.has('visual');

const {
  antetitulo,
  titulo,
  subtitulo,
  refuerzo,
  ctaPrimario = { texto: 'Agenda tu diagnóstico', href: '/diagnostico' },
  contextoWhatsApp,
} = Astro.props;
---

<section class="seccion puntos bg-void">
  <div
    class:list={[
      'contenedor',
      tieneVisual && 'grid items-center gap-12 lg:grid-cols-[1fr_auto] lg:gap-16',
    ]}
  >
    <div>
    {antetitulo && <SectionLabel texto={antetitulo} />}
    <h1 class:list={['mt-4', tieneVisual ? 'max-w-2xl' : 'max-w-3xl']}>
      {titulo}
    </h1>
    <p class="lead mt-6 max-w-2xl">{subtitulo}</p>

    <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
      <a
        href={ctaPrimario.href}
        class="boton boton-primario"
      >
        {ctaPrimario.texto}
      </a>
      {
        contextoWhatsApp && (
          <a
            href={waLink(contextoWhatsApp)}
            target="_blank"
            rel="noopener"
            class="boton boton-secundario"
          >
            <Icon nombre="whatsapp" tamano={20} />
            Escríbenos por WhatsApp
          </a>
        )
      }
    </div>

    {
      refuerzo && (
        <p class="pequeno mt-5 max-w-md text-texto-2">{refuerzo}</p>
      )
    }
    </div>

    {
      tieneVisual && (
        <div class="flex justify-center lg:justify-end">
          <slot name="visual" />
        </div>
      )
    }
  </div>
</section>
