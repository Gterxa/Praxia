---
/**
 * Mini-widget de datos para las tarjetas de capacidades. HTML y CSS, sin
 * imágenes. El cian marca lo que es dato; el brasa, un solo acento por widget.
 * Muestran etiquetas ("Cita confirmada"), nunca cifras de negocio.
 */
import StatusPill from './StatusPill.astro';

interface Props {
  tipo: 'chat' | 'agenda' | 'clientes' | 'documentos' | 'reportes' | 'contenido';
  class?: string;
}
const { tipo, class: clase = '' } = Astro.props;
---

<div class:list={['widget', `widget-${tipo}`, clase]} aria-hidden="true">
  {
    tipo === 'chat' && (
      <>
        <span class="burbuja">¿Tienen espacio mañana?</span>
        <span class="burbuja es-negocio">Sí, de 9 a 7. ¿Te reservo las 10?</span>
      </>
    )
  }
  {
    tipo === 'agenda' && (
      <>
        <span class="fila">
          <span class="hora">10:00</span>
          <span class="texto">Control</span>
          <StatusPill texto="confirmada" estado="verde" class="ml-auto" />
        </span>
        <span class="fila">
          <span class="hora">11:30</span>
          <span class="texto">Vacuna</span>
          <StatusPill texto="recordatorio enviado" estado="cian" class="ml-auto" />
        </span>
      </>
    )
  }
  {
    tipo === 'clientes' && (
      <>
        <span class="fila">
          <span class="texto">Consultó anoche</span>
          <StatusPill texto="responder" estado="cian" class="ml-auto" />
        </span>
        <span class="fila">
          <span class="texto">Pidió cotización</span>
          <StatusPill texto="seguimiento" estado="ambar" class="ml-auto" />
        </span>
        <span class="fila">
          <span class="texto">Listo para comprar</span>
          <StatusPill texto="llamar" estado="verde" class="ml-auto" />
        </span>
      </>
    )
  }
  {
    tipo === 'documentos' && (
      <>
        <span class="archivo">factura-marzo.pdf<span class="etiqueta">proveedor</span></span>
        <span class="archivo">contrato-lopez.docx<span class="etiqueta">cliente</span></span>
        <span class="archivo">boleta-0412.jpg<span class="etiqueta">gasto</span></span>
      </>
    )
  }
  {
    tipo === 'reportes' && (
      <>
        <span class="barras">
          <span class="widget-barra" data-alto="3" />
          <span class="widget-barra" data-alto="5" />
          <span class="widget-barra" data-alto="4" />
          <span class="widget-barra es-acento" data-alto="6" />
        </span>
        <span class="eje">
          <span>lun</span>
          <span>mar</span>
          <span>mié</span>
          <span>jue</span>
        </span>
      </>
    )
  }
  {
    tipo === 'contenido' && (
      <>
        <span class="post-cabecera">
          <span class="hora">jue 9:00</span>
          <StatusPill texto="para revisar" estado="ambar" class="ml-auto" />
        </span>
        <span class="linea ancha" />
        <span class="linea" />
        <span class="linea corta" />
      </>
    )
  }
</div>

<style>
  .widget {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.4375rem;
    height: 6.5rem;
    padding: 0.875rem;
    border: 1px solid var(--color-linea);
    border-radius: var(--radius-praxia);
    background-color: var(--color-void);
    font-size: 0.75rem;
    line-height: 1.3;
    color: var(--color-texto-2);
    overflow: hidden;
  }

  /* --- chat --- */
  .burbuja {
    align-self: flex-start;
    max-width: 82%;
    padding: 0.375rem 0.625rem;
    border: 1px solid var(--color-linea);
    border-radius: 0.5rem 0.5rem 0.5rem 0.125rem;
    background-color: var(--color-surface-2);
    color: var(--color-texto);
  }

  .burbuja.es-negocio {
    align-self: flex-end;
    border-radius: 0.5rem 0.5rem 0.125rem 0.5rem;
    background-color: var(--color-wa);
    border-color: color-mix(in srgb, var(--color-verde) 22%, transparent);
  }

  /* --- filas (agenda, clientes) --- */
  .fila {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
  }

  .fila .texto {
    color: var(--color-texto);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .hora {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    color: var(--color-cian);
  }

  /* --- documentos --- */
  .archivo {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--color-texto);
    white-space: nowrap;
    overflow: hidden;
  }

  .etiqueta {
    flex: none;
    padding: 0.0625rem 0.375rem;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--color-cian) 35%, transparent);
    color: var(--color-cian);
    letter-spacing: 0.06em;
  }

  /* --- reportes --- */
  .barras {
    display: flex;
    align-items: flex-end;
    gap: 0.5rem;
    height: 3.25rem;
  }

  .widget-barra {
    flex: 1;
    border-radius: 0.1875rem 0.1875rem 0 0;
    background-color: color-mix(in srgb, var(--color-cian) 55%, transparent);
  }

  .widget-barra.es-acento {
    background-color: var(--color-brasa);
  }

  .widget-barra[data-alto='3'] {
    height: 40%;
  }
  .widget-barra[data-alto='4'] {
    height: 55%;
  }
  .widget-barra[data-alto='5'] {
    height: 75%;
  }
  .widget-barra[data-alto='6'] {
    height: 100%;
  }

  .eje {
    display: flex;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.06em;
    color: var(--color-texto-3);
  }

  .eje span {
    flex: 1;
    text-align: center;
  }

  /* --- contenido --- */
  .post-cabecera {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .linea {
    display: block;
    height: 0.375rem;
    width: 70%;
    border-radius: 999px;
    background-color: var(--color-surface-2);
  }

  .linea.ancha {
    width: 92%;
  }

  .linea.corta {
    width: 45%;
  }
</style>
