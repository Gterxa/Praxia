---
/**
 * Acordeón en dos columnas + animación (patrón "faq" de cosmoq). Reusado en
 * la home, /preguntas-frecuentes y /como-trabajamos, con 6/10/5 preguntas
 * respectivamente, y en anchos de contenedor distintos (max-w-3xl en home y
 * /preguntas-frecuentes, .contenedor completo en /como-trabajamos) — el
 * layout de columnas se adapta a cualquiera de los dos.
 *
 * La respuesta admite HTML (enlaces) vía set:html, igual que antes.
 */
interface Props {
  preguntas: readonly { pregunta: string; respuesta: string }[];
  titulo?: string;
  /** Deja la primera pregunta abierta: responde la duda más común sin un clic. */
  abrirPrimera?: boolean;
}
const { preguntas, titulo, abrirPrimera = false } = Astro.props;

// Prefijo por instancia: si el día de mañana se renderizan dos <FAQ> en la
// misma página, los ids de aria-controls no colisionan.
const idBase = `faq-${Math.random().toString(36).slice(2, 8)}`;

// Primera mitad (redondeando hacia arriba) en la columna 1, el resto en la
// columna 2 — funciona igual con 5, 6 o 10 preguntas. Si solo hay una
// columna con contenido (0-1 preguntas), la segunda no se renderiza.
const mitad = Math.ceil(preguntas.length / 2);
const columnas = [preguntas.slice(0, mitad), preguntas.slice(mitad)].filter((col) => col.length > 0);
---

<div>
  {titulo && <h2 class="mb-8">{titulo}</h2>}
  <div class="faq__content">
    {
      columnas.map((columna, ci) => (
        <div class="faq__col">
          {columna.map((p, i) => {
            const indice = ci === 0 ? i : mitad + i;
            const abierta = abrirPrimera && indice === 0;
            const idPregunta = `${idBase}-q-${indice}`;
            const idRespuesta = `${idBase}-a-${indice}`;
            return (
              <div class:list={['faq__item', abierta && 'is-open']}>
                <h3 class="faq__q-heading">
                  <button
                    type="button"
                    class="faq__q"
                    id={idPregunta}
                    aria-expanded={abierta}
                    aria-controls={idRespuesta}
                  >
                    <p>{p.pregunta}</p>
                    <span class="faq__icon" aria-hidden="true" />
                  </button>
                </h3>
                <div class="faq__a" id={idRespuesta} role="region" aria-labelledby={idPregunta}>
                  <div>
                    <p set:html={p.respuesta} />
                  </div>
                </div>
              </div>
            );
          })}
        </div>
      ))
    }
  </div>
</div>

<style>
  .faq__content {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    width: 100%;
  }

  @media (min-width: 48rem) {
    .faq__content {
      flex-direction: row;
      justify-content: center;
      gap: 2rem;
    }
  }

  .faq__col {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    width: 100%;
  }

  @media (min-width: 48rem) {
    .faq__col {
      flex: 1 1 0%;
      min-width: 0;
    }
  }

  .faq__item {
    position: relative;
    width: 100%;
    background-color: var(--color-surface-2);
    border-radius: var(--radius-tarjeta);
    overflow: hidden;
  }

  .faq__item::after {
    content: '';
    position: absolute;
    inset: 0;
    /* --line de cosmoq → linea-viva al 16%, igual que CabeceraSeccion/scard. */
    border: 1px solid rgb(84 124 255 / 0.16);
    border-radius: inherit;
    pointer-events: none;
    transition: border-color 300ms var(--ease-suave);
  }

  .faq__item:hover::after,
  .faq__item:focus-within::after {
    border-color: var(--color-linea-viva);
  }

  .faq__q-heading {
    display: contents;
  }

  .faq__q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    width: 100%;
    padding: 1.25rem;
    background: transparent;
    border: none;
    text-align: left;
    cursor: pointer;
    color: inherit;
    font: inherit;
    transition: background-color 300ms var(--ease-suave);
  }

  .faq__q:hover {
    background-color: rgb(255 255 255 / 0.03);
  }

  .faq__q:focus-visible {
    outline: 2px solid var(--color-brasa);
    outline-offset: -2px;
  }

  .faq__q:active {
    background-color: rgb(255 255 255 / 0.05);
  }

  .faq__q p {
    font-family: var(--font-titulos);
    font-weight: 500;
    font-size: 1.125rem;
    line-height: 1.4;
    letter-spacing: -0.03em;
    color: var(--color-texto);
  }

  /* Ícono "+" dibujado con dos barras (nunca un SVG de flecha rotado: no lee
     como "+"). Al abrir, gira 45° y el trazo se ve como "×". */
  .faq__icon {
    position: relative;
    flex: none;
    width: 1.125rem;
    height: 1.125rem;
    transition: transform 400ms var(--ease-resorte);
  }

  .faq__icon::before,
  .faq__icon::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    background-color: var(--color-brasa);
    border-radius: 999px;
  }

  .faq__icon::before {
    width: 100%;
    height: 1.5px;
    transform: translate(-50%, -50%);
  }

  .faq__icon::after {
    width: 1.5px;
    height: 100%;
    transform: translate(-50%, -50%);
  }

  .faq__item.is-open .faq__icon {
    transform: rotate(45deg);
  }

  .faq__a {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 450ms var(--ease-resorte);
  }

  .faq__a > div {
    overflow: hidden;
  }

  .faq__a p {
    padding: 1.25rem;
    padding-top: 0;
    font-size: 1rem;
    line-height: 1.5rem;
    color: var(--color-texto-2);
  }

  .faq__item.is-open .faq__a {
    grid-template-rows: 1fr;
  }

  @media (prefers-reduced-motion: reduce) {
    .faq__a,
    .faq__icon {
      transition: none;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.faq__item').forEach((item) => {
    const boton = item.querySelector<HTMLButtonElement>('.faq__q');
    boton?.addEventListener('click', () => {
      const abierta = item.classList.toggle('is-open');
      boton.setAttribute('aria-expanded', String(abierta));
    });
  });
</script>
