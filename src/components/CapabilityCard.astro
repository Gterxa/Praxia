---
import Widget from './Widget.astro';

interface Props {
  href: string;
  titulo: string;
  resumen: string;
  icono: 'conversacion' | 'calendario' | 'personas' | 'documentos' | 'reportes' | 'contenido';
  /** Nivel del encabezado, para no romper la jerarquía de la página. */
  nivel?: 2 | 3;
  /** Marca la tarjeta que conecta con soluciones mayores. */
  destacada?: boolean;
  /** Ocupa dos columnas en la grilla: rompe la simetría del bento. */
  ancha?: boolean;
}

const { href, titulo, resumen, icono, nivel = 3, destacada = false, ancha = false } = Astro.props;
const Titulo = `h${nivel}` as 'h2' | 'h3';

/** Cada capacidad tiene su widget: el ícono ya no hace falta. */
const widgets = {
  conversacion: 'chat',
  calendario: 'agenda',
  personas: 'clientes',
  documentos: 'documentos',
  reportes: 'reportes',
  contenido: 'contenido',
} as const;
---

<a
  href={href}
  class:list={[
    'tarjeta flex flex-col',
    destacada && '!border-brasa',
    ancha && 'md:col-span-2',
  ]}
>
  <Widget tipo={widgets[icono]} class={ancha ? 'md:max-w-sm' : undefined} />
  <Titulo class="mt-5 text-[1.1875rem] md:text-[1.3125rem]">{titulo}</Titulo>
  <p class="mt-2.5 max-w-md text-texto-2">{resumen}</p>
  <span class="pequeno mt-5 font-semibold text-brasa">Ver cómo funciona</span>
</a>
