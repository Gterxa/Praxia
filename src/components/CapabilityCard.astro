---
import Icon from './Icon.astro';

interface Props {
  href: string;
  titulo: string;
  resumen: string;
  icono: 'conversacion' | 'calendario' | 'personas' | 'documentos' | 'reportes' | 'contenido';
  /** Nivel del encabezado, para no romper la jerarquía de la página. */
  nivel?: 2 | 3;
  /** Marca la tarjeta que conecta con soluciones mayores. */
  destacada?: boolean;
}

const { href, titulo, resumen, icono, nivel = 3, destacada = false } = Astro.props;
const Titulo = `h${nivel}` as 'h2' | 'h3';
---

<a
  href={href}
  class:list={['group tarjeta flex flex-col', destacada && '!border-brasa']}
>
  {
    destacada && (
      <span class="pequeno mono mb-3 inline-flex w-fit items-center rounded-full border border-brasa/40 bg-brasa-tenue px-2 py-0.5 text-brasa">
        Conecta con soluciones mayores
      </span>
    )
  }
  <span
    class="inline-flex h-11 w-11 items-center justify-center rounded-praxia bg-brasa-tenue text-brasa"
  >
    <Icon nombre={icono} tamano={22} />
  </span>
  <Titulo class="mt-5 text-[1.1875rem] md:text-[1.3125rem]">{titulo}</Titulo>
  <p class="mt-2.5 text-texto-2">{resumen}</p>
  <span
    class="pequeno mt-5 inline-flex items-center gap-1.5 font-semibold text-brasa group-hover:gap-2.5 motion-safe:transition-all"
  >
    Ver cómo funciona
    <Icon nombre="flecha" tamano={16} />
  </span>
</a>
