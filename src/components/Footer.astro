---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { SITE, waLink, CONTEXTO, EMAIL, mailtoLink } from '../consts';
import { ruta } from '../rutas';

const anio = new Date().getFullYear();
---

<footer class="relative overflow-hidden border-t border-linea">
  <div class="contenedor py-14 md:py-16">
    <div class="grid gap-10 md:grid-cols-2 lg:grid-cols-4 lg:gap-8">
      <div class="lg:col-span-1">
        <Logo />
        <p class="pequeno mt-4 max-w-[26ch] text-texto-2">{SITE.tagline}</p>
      </div>

      <div>
        <h2 class="font-[family-name:var(--font-cuerpo)] text-[0.8125rem] font-semibold tracking-[0.09em] text-texto-2 uppercase">
          Servicios
        </h2>
        <ul class="mt-4 space-y-2.5">
          <li>
            <a href={ruta('/que-puedes-automatizar')} class="pequeno text-texto-2 hover:text-brasa hover:underline">
              Automatización con IA
            </a>
          </li>
          <li>
            <a href={ruta('/servicios#web')} class="pequeno text-texto-2 hover:text-brasa hover:underline">
              Web, SEO y presencia local
            </a>
          </li>
          <li>
            <a href={ruta('/servicios#seguridad')} class="pequeno text-texto-2 hover:text-brasa hover:underline">
              Seguridad y mantenimiento
            </a>
          </li>
        </ul>
      </div>

      <div>
        <h2 class="font-[family-name:var(--font-cuerpo)] text-[0.8125rem] font-semibold tracking-[0.09em] text-texto-2 uppercase">
          Praxia
        </h2>
        <ul class="mt-4 space-y-2.5">
          <li><a href={ruta('/#servicios')} class="pequeno text-texto-2 hover:text-brasa hover:underline">Industrias</a></li>
          <li><a href={ruta('/como-trabajamos')} class="pequeno text-texto-2 hover:text-brasa hover:underline">Cómo trabajamos</a></li>
          <li><a href={ruta('/casos')} class="pequeno text-texto-2 hover:text-brasa hover:underline">Casos</a></li>
          <li><a href={ruta('/nosotros')} class="pequeno text-texto-2 hover:text-brasa hover:underline">Nosotros</a></li>
          <li><a href={ruta('/preguntas-frecuentes')} class="pequeno text-texto-2 hover:text-brasa hover:underline">Preguntas frecuentes</a></li>
        </ul>
      </div>

      <div>
        <h2 class="font-[family-name:var(--font-cuerpo)] text-[0.8125rem] font-semibold tracking-[0.09em] text-texto-2 uppercase">
          Contacto
        </h2>
        <ul class="mt-4 space-y-2.5">
          <li>
            <a
              href={waLink(CONTEXTO.flotante)}
              class="pequeno inline-flex items-center gap-2 text-texto-2 hover:text-brasa hover:underline"
              rel="noopener"
              target="_blank"
            >
              <Icon nombre="whatsapp" tamano={16} />
              WhatsApp
            </a>
          </li>
          <li>
            <a
              href={mailtoLink}
              class="pequeno inline-flex items-center gap-2 text-texto-2 hover:text-brasa hover:underline"
            >
              <Icon nombre="correo" tamano={16} />
              {EMAIL}
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-12 flex flex-col gap-4 border-t border-linea pt-8 sm:flex-row sm:items-center sm:justify-between">
      <p class="pequeno text-texto-2">{anio} {SITE.nombre} · Lima, Perú</p>
      <div class="flex gap-5">
        <a href={ruta('/legal')} class="pequeno text-texto-2 hover:text-brasa hover:underline">Términos legales</a>
        <a href={ruta('/privacidad')} class="pequeno text-texto-2 hover:text-brasa hover:underline">Privacidad</a>
        <a href={ruta('/seguridad')} class="pequeno text-texto-2 hover:text-brasa hover:underline">Seguridad</a>
      </div>
    </div>
  </div>

  <!-- Wordmark fantasma en degradado cálido: puro remate decorativo. -->
  <p class="wordmark-fantasma" aria-hidden="true">Praxia</p>
</footer>

<style>
  .wordmark-fantasma {
    margin: 0;
    padding-inline: 1.25rem;
    padding-bottom: 0.5rem;
    text-align: center;
    font-family: var(--font-titulos);
    font-weight: 700;
    line-height: 0.8;
    font-size: clamp(4rem, 18vw, 11rem);
    letter-spacing: -0.04em;
    background: var(--degradado-calido);
    background-clip: text;
    -webkit-background-clip: text;
    color: transparent;
    opacity: 0.14;
    user-select: none;
  }
</style>
