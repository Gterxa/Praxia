---
/**
 * Los 4 pasos del método, en tarjetas sticky que se van apilando mientras
 * avanza el scroll, con un beam HORIZONTAL de progreso en degradado cálido
 * arriba de las tarjetas (patrón "steps" de la réplica de cosmoq: números en
 * fila + línea que se llena de izquierda a derecha, en vez del riel vertical
 * de la v1). En celular (`< 64rem`) es una lista simple: el sticky y el beam
 * no aportan nada en una pantalla que ya ocupa toda la tarjeta.
 */
import Seccion from './Seccion.astro';
import CabeceraSeccion from './CabeceraSeccion.astro';
import { METODO } from '../consts';
---

<Seccion id="proceso" class="seccion-cosmoq">
  <CabeceraSeccion etiqueta="Cómo trabajamos" icono="flecha">
    <h2 slot="titulo" class="revelar" data-retraso="1">Cuatro pasos, sin sorpresas</h2>
    <p slot="subtitulo" class="revelar" data-retraso="2">
      De la primera conversación a un sistema andando.
    </p>
  </CabeceraSeccion>

  <div class="proceso mt-10" id="proceso-content">
    <div class="proceso-beam" aria-hidden="true">
      <div class="proceso-beam-numeros">
        {
          METODO.map((paso) => (
            <div class="proceso-beam-num">
              <span class="mono text-brasa">{String(paso.numero).padStart(2, '0')}</span>
              <span class="proceso-beam-titulo">{paso.titulo}</span>
            </div>
          ))
        }
      </div>
      <div class="proceso-beam-linea">
        <div class="proceso-beam-relleno" id="proceso-relleno"></div>
      </div>
    </div>

    <ol class="proceso-lista">
      {
        METODO.map((paso) => (
          <li class="proceso-paso">
            <div class="tarjeta proceso-tarjeta">
              <div class="proceso-tarjeta-contenido">
                <span class="mono text-brasa">{String(paso.numero).padStart(2, '0')}</span>
                <h3 class="mt-2 text-[1.1875rem] font-semibold text-texto md:text-[1.375rem]">{paso.titulo}</h3>
                <p class="mt-2.5 text-texto-2">{paso.detalle}</p>
                <dl class="mt-5 grid grid-cols-2 gap-x-4 gap-y-2 border-t border-linea pt-4">
                  {paso.panel.map((d) => (
                    <div>
                      <dt class="pequeno text-texto-3">{d.clave}</dt>
                      <dd class="text-[0.9375rem] font-medium text-texto">{d.valor}</dd>
                    </div>
                  ))}
                </dl>
              </div>
              <div class="proceso-tarjeta-panel" aria-hidden="true">
                <span class="proceso-tarjeta-panel-numero">{String(paso.numero).padStart(2, '0')}</span>
              </div>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</Seccion>

<style>
  .proceso {
    position: relative;
  }

  .proceso-lista {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .proceso-beam {
    display: none;
  }

  .proceso-tarjeta {
    display: flex;
    flex-direction: column;
  }

  .proceso-tarjeta-panel {
    display: none;
  }

  @media (min-width: 64rem) {
    /* Fila de números sticky + línea de progreso horizontal, igual mecanismo
       que el riel vertical de la v1 (sticky al mismo `top` que las tarjetas)
       pero en el eje X: los números quedan fijos arriba mientras la línea se
       llena de izquierda a derecha según el progreso del scroll por toda la
       sección. */
    .proceso-beam {
      display: block;
      position: sticky;
      top: 6.5rem;
      z-index: 3;
      margin-bottom: 2.5rem;
    }

    .proceso-beam-numeros {
      display: flex;
      align-items: center;
      gap: 0.625rem;
      width: 100%;
    }

    .proceso-beam-num {
      display: flex;
      flex: 1 0 0;
      align-items: center;
      gap: 0.625rem;
      overflow: clip;
    }

    .proceso-beam-titulo {
      overflow: hidden;
      white-space: nowrap;
      text-overflow: ellipsis;
      font-size: 0.9375rem;
      font-weight: 500;
      color: var(--color-texto-2);
    }

    .proceso-beam-linea {
      position: relative;
      margin-top: 0.875rem;
      width: 100%;
      height: 2px;
      background: rgb(84 124 255 / 0.16);
      overflow: hidden;
    }

    .proceso-beam-relleno {
      width: 100%;
      height: 100%;
      background: var(--degradado-calido);
      transform: scaleX(0);
      transform-origin: left;
      /* Sin transición: sigue al scroll cuadro a cuadro (igual que el beam
         de la réplica de cosmoq), así no se atrasa respecto al dedo/rueda. */
    }

    .proceso-paso {
      position: sticky;
      top: 6.5rem;
    }

    .proceso-tarjeta {
      /* `.tarjeta` trae padding:1.5rem para el layout apilado de mobile; en
         desktop el padding lo controla `.proceso-tarjeta-contenido` (solo a
         la izquierda, como el step-card de cosmoq) para que el panel de la
         derecha llegue a los cuatro bordes de la tarjeta. */
      padding: 0;
      flex-direction: row;
      align-items: stretch;
      gap: 2.5rem;
      min-height: 22rem;
      overflow: hidden;
    }

    .proceso-tarjeta-contenido {
      display: flex;
      flex-direction: column;
      justify-content: center;
      flex: 1 1 auto;
      min-width: 0;
      padding: 2.5rem 0 2.5rem 2.5rem;
    }

    .proceso-tarjeta-panel {
      display: flex;
      align-items: center;
      justify-content: center;
      flex: 0 0 34%;
      position: relative;
      overflow: hidden;
      background: var(--color-surface-2);
    }

    /* Franja decorativa: no hay imagen real del paso, así que el relleno
       visual es el degradado "atardecer" a muy baja opacidad detrás del
       número del paso gigante y fantasma — capa aparte (no
       background-blend-mode) para controlar la opacidad exacta y que no
       compita con el contenido de la izquierda. */
    .proceso-tarjeta-panel::before {
      content: '';
      position: absolute;
      inset: 0;
      background-image: var(--degradado-atardecer);
      opacity: 0.14;
    }

    .proceso-tarjeta-panel-numero {
      position: relative;
      font-family: var(--font-mono);
      font-size: 10rem;
      line-height: 1;
      color: var(--color-texto);
      opacity: 0.08;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .proceso-beam-relleno {
      transform: scaleX(1);
    }
  }
</style>

<script>
  const contenedor = document.getElementById('proceso-content');
  const relleno = document.getElementById('proceso-relleno');
  const reducido = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (contenedor && relleno && !reducido) {
    const actualizar = () => {
      const r = contenedor.getBoundingClientRect();
      const total = r.height - window.innerHeight * 0.5;
      const p = Math.min(1, Math.max(0, -r.top / Math.max(1, total)));
      relleno.style.transform = `scaleX(${p})`;
    };
    actualizar();
    window.addEventListener('scroll', actualizar, { passive: true });
    window.addEventListener('resize', actualizar);
  }
</script>
