---
/**
 * Los 4 pasos del método. Mecanismo portado de "stacking-card" (ui-layout /
 * 21st.dev, vía motion): cada tarjeta queda sticky y la siguiente la tapa
 * por encima, escalándose hacia abajo mientras el scroll avanza. Reemplaza
 * el sticky vainilla + beam horizontal anterior (ver historial de este
 * archivo) por el mismo mecanismo del componente de referencia.
 */
import Seccion from './Seccion.astro';
import CabeceraSeccion from './CabeceraSeccion.astro';
import StackingSteps from './ui/stacking-steps';
import { METODO } from '../consts';
---

<Seccion id="proceso" class="seccion-cosmoq">
  <CabeceraSeccion etiqueta="Cómo trabajamos" icono="flecha">
    <h2 slot="titulo" class="revelar" data-retraso="1">Cuatro pasos, sin sorpresas</h2>
    <p slot="subtitulo" class="revelar" data-retraso="2">
      De la primera conversación a un sistema andando.
    </p>
  </CabeceraSeccion>

  <StackingSteps pasos={METODO} client:visible />
</Seccion>
