---
import * as si from 'simple-icons';
import Seccion from './Seccion.astro';
import CabeceraSeccion from './CabeceraSeccion.astro';
import { GlassWeeks } from './ui/glass-weeks';
import { OrbitTools } from './ui/orbit-tools';
import { PORQUE } from '../porque';
import { ruta } from '../rutas';

// Mismo patrón que Herramientas.astro: nombre de simple-icons -> trazo SVG.
// Sin ícono disponible (p. ej. "Tu web", que no es una marca), el nombre va solo.
const trazoIcono = (nombre?: string) => {
  if (!nombre) return null;
  const clave = `si${nombre[0]!.toUpperCase()}${nombre.slice(1)}` as keyof typeof si;
  const icono = si[clave] as { path: string } | undefined;
  return icono?.path ?? null;
};

// Fila 1 = los 2 ítems más anchos del bento original (span 7 y 5: panel y
// anillo), lado a lado. Fila 2 = los 3 span-4 restantes (tachado, barras,
// chips), en fila propia. Se filtra por `span` en vez de por índice fijo
// para no depender del orden exacto en porque.ts.
const filaAncha = PORQUE.filter((t) => t.span >= 5);
const filaAlta = PORQUE.filter((t) => t.span === 4);

// Glow de fondo por tarjeta (generado en la paleta de marca, ver
// public/porque/). Se reparten 3 assets entre las 5 tarjetas, igual que
// cosmoq reusa las suyas — no hace falta uno distinto por tarjeta.
const GLOW: Record<string, string> = {
  panel: 'glow-3.webp',
  anillo: 'glow-1.webp',
  tachado: 'glow-2.webp',
  barras: 'glow-1.webp',
  chips: 'glow-3.webp',
};
---

<Seccion id="por-que" class="seccion-cosmoq">
  <CabeceraSeccion etiqueta="Por qué Praxia" icono="check">
    <h2 slot="titulo" class="revelar" data-retraso="1">Alcanzable para un negocio como el tuyo</h2>
    <p slot="subtitulo" class="lead revelar" data-retraso="2">
      No hace falta un área de tecnología ni un presupuesto de corporación. Hace falta saber qué
      quieres, y eso ya lo tienes.
    </p>
  </CabeceraSeccion>

  <div class="mt-10 flex flex-col gap-6 lg:gap-8">
    <div class="flex flex-col gap-4 lg:flex-row lg:gap-6">
      {
        filaAncha.map((t, i) => (
          <article
            class:list={['tarjeta tarjeta-fcard min-w-0 flex-1 revelar']}
            data-retraso={String(i + 1)}
          >
            <div class="fcard-visual fcard-visual--fila1">
              <img src={ruta(`/porque/${GLOW[t.tipo]}`)} alt="" class="fcard-glow" aria-hidden="true" loading="lazy" />

              {t.tipo === 'panel' && (
                <>
                  <svg
                    class="fcard-lineas fcard-capa"
                    viewBox="0 0 578 462"
                    preserveAspectRatio="none"
                    aria-hidden="true"
                  >
                    <path
                      d="M 0 144 L 222 0 L 577.5 162.5 L 325.5 461.5 L 0 245 L 119 0 L 577.5 95.5 L 0 199 L 577.5 419 L 69.5 0 L 119 461.5 L 428 0 L 487.5 461.5"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1"
                    />
                  </svg>
                  <div class="fcard-destellos fcard-capa" aria-hidden="true">
                    <i class="destello" /><i class="destello destello--calido" />
                    <i class="destello" /><i class="destello destello--calido" />
                    <i class="destello" /><i class="destello destello--calido" />
                  </div>
                </>
              )}
              {t.tipo === 'panel' && (
                <div class="crono" data-crono aria-hidden="true">
                  <div class="crono-lectura">
                    <span class="crono-grupo" data-crono-mm>
                      <span class="crono-digito" data-pos="0"><span class="crono-cinta" /></span>
                      <span class="crono-digito" data-pos="1"><span class="crono-cinta" /></span>
                    </span>
                    <span class="crono-sep">:</span>
                    <span class="crono-grupo" data-crono-ss>
                      <span class="crono-digito" data-pos="0"><span class="crono-cinta" /></span>
                      <span class="crono-digito" data-pos="1"><span class="crono-cinta" /></span>
                    </span>
                    <span class="crono-sep crono-sep--punto">.</span>
                    <span class="crono-grupo crono-grupo--ms" data-crono-ms>
                      <span class="crono-digito" data-pos="0"><span class="crono-cinta" /></span>
                      <span class="crono-digito" data-pos="1"><span class="crono-cinta" /></span>
                      <span class="crono-digito" data-pos="2"><span class="crono-cinta" /></span>
                    </span>
                  </div>
                  <p class="crono-pie">{t.gratis.monto} · {t.gratis.duracion} de diagnóstico</p>
                </div>
              )}

              {t.tipo === 'anillo' && (
                <>
                  <div class="fcard-brillos fcard-capa" aria-hidden="true">
                    <i class="brillo" /><i class="brillo" /><i class="brillo" /><i class="brillo" />
                  </div>
                  <div class="anillo" aria-hidden="true">
                    <div class="anillo-orbita">
                      {t.nodos.map((n, ni) => (
                        <span class="anillo-nodo mono" data-i={ni}>
                          {n}
                        </span>
                      ))}
                    </div>
                    <span class="anillo-centro mono">P</span>
                  </div>
                </>
              )}

              <div class="fcard-texto">
                <h3 class="text-[1.0625rem] font-semibold text-texto md:text-[1.1875rem]">
                  {t.titulo}
                </h3>
                <p class="text-[0.9375rem] text-texto-2">{t.texto}</p>
              </div>
            </div>
          </article>
        ))
      }
    </div>

    <div class="flex flex-col gap-4 lg:flex-row lg:gap-6">
      {
        filaAlta.map((t, i) => (
          <article
            class:list={['tarjeta tarjeta-fcard min-w-0 flex-1 revelar']}
            data-retraso={String(i + 1)}
          >
            <div class="fcard-visual fcard-visual--fila2">
              <img src={ruta(`/porque/${GLOW[t.tipo]}`)} alt="" class="fcard-glow" aria-hidden="true" loading="lazy" />
              {t.tipo === 'tachado' && (
                <>
                  <div class="radar fcard-capa" aria-hidden="true">
                    <div class="radar-anillo" />
                    <div class="radar-haz" />
                    <i class="radar-contacto" /><i class="radar-contacto" /><i class="radar-contacto" />
                  </div>
                  <div class="tachado-caja font-[family-name:var(--font-mono)] text-[0.8125rem]">
                    <p class="tachado text-texto-3">«{t.antes}»</p>
                    <p class="text-texto">«{t.despues}»</p>
                  </div>
                </>
              )}

              {t.tipo === 'barras' && (
                <>
                  <svg
                    class="fcard-lineas fcard-capa"
                    viewBox="0 0 578 462"
                    preserveAspectRatio="none"
                    aria-hidden="true"
                  >
                    <path
                      d="M 0 144 L 222 0 L 577.5 162.5 L 325.5 461.5 L 0 245 L 119 0 L 577.5 95.5 L 0 199 L 577.5 419 L 69.5 0 L 119 461.5 L 428 0 L 487.5 461.5"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1"
                    />
                  </svg>
                  <div class="fcard-destellos fcard-capa" aria-hidden="true">
                    <i class="destello" /><i class="destello destello--calido" />
                    <i class="destello" /><i class="destello destello--calido" />
                  </div>
                  <GlassWeeks semanas={t.semanas} client:visible />
                </>
              )}

              {t.tipo === 'chips' && (
                <OrbitTools
                  herramientas={t.chips
                    .map((c) => ({ nombre: c.nombre, path: trazoIcono(c.icono) }))
                    .filter((h): h is Omit<typeof h, 'path'> & { path: string } => h.path !== null)}
                  client:visible
                />
              )}

              <div class="fcard-texto">
                <h3 class="text-[1.0625rem] font-semibold text-texto md:text-[1.1875rem]">
                  {t.titulo}
                </h3>
                <p class="text-[0.9375rem] text-texto-2">{t.texto}</p>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</Seccion>

<style>
  /* --- Estructura de tarjeta "fcard" (patrón real de cosmoq): un único
     contenedor donde la imagen/decoración llena toda la tarjeta y el texto
     flota encima con blur, cerca del borde inferior — no dos zonas
     apiladas separadas por una línea (eso era una desviación mía sin
     validar, corregida). Diferencia real con cosmoq: sus "patterns" son
     puramente decorativos (líneas, destellos, sliders); acá el widget
     (tabla, anillo, antes/después, barras, chips) SÍ es contenido, así que
     se ancla arriba (`align-items: flex-start`) para no pelear con el
     texto flotante de abajo — cosmoq no tiene ese problema porque no hay
     nada que anclar. */
  .tarjeta-fcard {
    padding: 0;
    overflow: hidden;
  }

  .fcard-visual {
    position: relative;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    width: 100%;
    padding: 1.75rem 1.5rem;
  }

  /* --- Glow de marca (patrón cosmoq: cada card trae su propio glow de
     fondo, contenido dentro del borde de la card, nunca de página —
     FondoOrbes.astro ya sacó el brillo global, esto es una aplicación
     acotada y distinta). Igual que cosmoq, es una imagen real (generada
     en la rampa "atardecer" de tokens.css, no el azul/naranja literal de
     cosmoq, ver public/porque/) y no un radial-gradient de CSS: una
     imagen prerenderizada tiene un desvanecido mucho más suave que
     cualquier gradiente en capas, sin bandas. El grano ya viene incluido
     en la imagen. --- */
  .fcard-glow {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
  }

  /* Capas decorativas (líneas, destellos, brillos, radar): absolutas y
     detrás del widget. Ojo con la especificidad: la regla del widget de
     abajo es (0,2,0) y pisa un `position: absolute` declarado en una clase
     sola (0,1,0) — por eso las capas se excluyen ahí explícitamente. */
  .fcard-capa {
    position: absolute;
    z-index: 0;
    pointer-events: none;
  }

  .fcard-visual > *:not(.fcard-glow):not(.fcard-capa):not(.fcard-texto) {
    position: relative;
    z-index: 1;
  }

  /* --- Malla de líneas + destellos (patrón cosmoq de la card "Speed"):
     wireframe geométrico decorativo detrás del panel de datos, más 6
     mini-estrellas fugaces que atraviesan la tarjeta. Geometría genérica,
     no es un asset de marca — colores sí son de tokens.css. --- */
  .fcard-lineas {
    inset: 0;
    width: 100%;
    height: 100%;
    color: var(--color-texto);
    opacity: 0.35;
  }

  .fcard-destellos {
    inset: 0;
    overflow: hidden;
  }

  /* --- Línea de tiempo de la llamada de diagnóstico. Vive entre el panel de
     datos y el copy flotante: la tabla dice QUÉ sale de la llamada, esto dice
     CÓMO se llega. Cada tramo crece según sus minutos (--lt-peso alimenta el
     flex-grow), así que los anchos salen del dato de porque.ts y no de
     porcentajes escritos a mano: cambiar un `min` ahí re-reparte la barra
     sola. --- */
  /* .fcard-visual es flex row: sin este wrapper, la tabla y el timeline se
     ponen lado a lado y la tabla se estruja a media caja (cada fila parte en
     dos líneas). Apilados en columna, la tabla recupera el ancho completo. */
  .panel-pila {
    display: flex;
    flex-direction: column;
    width: 100%;
    min-width: 0;
  }

  /* --- Cronómetro deslizante de la llamada de diagnóstico. Cuenta 15:00.000
     hacia 0 y arranca cuando la card entra en viewport. Cada dígito es una
     cinta vertical con los diez numerales apilados que se desplaza con
     translateY: se anima solo transform (nunca el contenido de texto), que es
     lo único que el compositor puede mover sin relayout — con 3 dígitos de ms
     refrescando a 60fps, escribir textContent tiraría el frame. --- */
  .crono {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    width: 100%;
  }

  .crono-lectura {
    display: flex;
    align-items: baseline;
    justify-content: center;
    /* tabular-nums no alcanza: la cinta necesita una caja de ancho fijo por
       dígito o el separador baila cuando cambian las decenas. */
    font-variant-numeric: tabular-nums;
    font-weight: 700;
    letter-spacing: -0.04em;
    color: var(--color-texto);
  }

  .crono-grupo {
    display: flex;
  }

  .crono-digito {
    position: relative;
    display: block;
    width: 0.62em;
    height: 1em;
    overflow: hidden;
  }

  .crono-cinta {
    position: absolute;
    inset: 0;
    display: block;
    will-change: transform;
  }

  /* Los diez numerales de la cinta, apilados. Se generan acá y no en el HTML
     para no repetir 70 spans en el markup de la card. */
  .crono-cinta::before {
    content: '0\A 1\A 2\A 3\A 4\A 5\A 6\A 7\A 8\A 9';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    white-space: pre;
    text-align: center;
    line-height: 1;
  }

  .crono-sep {
    padding: 0 0.04em;
    color: var(--color-texto-3);
  }

  .crono-sep--punto {
    color: var(--color-brasa);
  }

  /* Los milisegundos van más chicos y en brasa: son el detalle que da la
     sensación de cronómetro vivo, pero no deben competir con mm:ss, que es
     el dato que se lee. */
  .crono-grupo--ms {
    font-size: 0.46em;
    color: var(--color-brasa);
    align-self: flex-end;
    padding-bottom: 0.12em;
  }

  .crono-lectura {
    font-size: clamp(2.75rem, 11vw, 4.25rem);
    line-height: 1;
  }

  .crono-pie {
    font-size: 0.9375rem;
    line-height: 1.4;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--color-texto-2, var(--color-texto));
    text-align: center;
    text-shadow: 0 1px 3px rgb(0 0 0 / 0.5);
  }

  .fcard-visual--fila1 .fcard-lineas {
    opacity: 0.22;
  }

  /* Mobile (bajo el lg donde el bento pasa a fila): la tabla crece porque sus
     filas parten en dos líneas y empujan el timeline dentro de la zona que el
     --fcard-fundido apaga, así que las etiquetas quedaban invisibles. Se deja
     solo la barra segmentada —que ya comunica la proporción por sí sola— y el
     texto se mantiene accesible en el aria-label de cada tramo. */
  @media (width < 64rem) {
    /* .fcard-texto es absolute anclado al fondo (bottom:1rem, z-index:2) y en
       mobile crece a cuatro líneas, así que pasaba por encima del timeline,
       que va en flujo. El padding le reserva la banda que ocupa ese panel:
       ~11rem de copy + su inset. No es el --fcard-fundido, que solo enmascara
       las capas decorativas a sangre. */
    /* El panel de texto (absolute, bottom:1rem) mide ~206px en mobile y
       arrancaba a 0.5px del timeline, tapándolo entero. Medido en el DOM a
       390px: tabla termina en 2196, timeline 2208-2212, panel 2208-2415.
       El timeline sube por encima de esa banda con un margen propio; el
       padding en .panel-pila no servía porque crece hacia abajo, no empuja
       el contenido hacia arriba. */
    .linea-tiempo {
      margin-bottom: 13rem;
    }

    .lt-etapa,
    .lt-min {
      /* clip, no display:none: el lector de pantalla sigue llegando al
         aria-label del tramo, que es donde vive el dato en esta versión. */
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    .linea-tiempo {
      margin-top: 0.75rem;
    }

    .lt-barra {
      height: 4px;
    }
  }

  .destello {
    position: absolute;
    width: 0.875rem;
    height: 2px;
    border-radius: 999px;
    background: linear-gradient(90deg, var(--color-linea-viva) 0%, var(--color-texto) 100%);
    animation: destello-cruzar 6s linear infinite;
  }

  .destello--calido {
    background: linear-gradient(90deg, var(--color-brasa) 0%, var(--color-texto) 100%);
  }

  @keyframes destello-cruzar {
    0% {
      transform: translate(var(--x0, 0), var(--y0, 0)) rotate(var(--r, 0deg));
      opacity: 0;
    }
    10%,
    90% {
      opacity: 1;
    }
    100% {
      transform: translate(var(--x1, 0), var(--y1, 0)) rotate(var(--r, 0deg));
      opacity: 0;
    }
  }

  .destello:nth-child(1) {
    left: 15%;
    top: 8%;
    --r: 12deg;
    --x1: 4rem;
    --y1: 1rem;
    animation-delay: -1s;
  }
  .destello:nth-child(2) {
    left: 68%;
    top: 10%;
    --r: 60deg;
    --x1: 2rem;
    --y1: 3.6rem;
    animation-delay: -3s;
  }
  .destello:nth-child(3) {
    left: 82%;
    top: 78%;
    --r: -70deg;
    --x1: -1rem;
    --y1: -3rem;
    animation-delay: -2s;
  }
  .destello:nth-child(4) {
    left: 12%;
    top: 60%;
    --r: -33deg;
    --x1: 4.6rem;
    --y1: -3rem;
    animation-delay: -4.5s;
  }
  .destello:nth-child(5) {
    left: 48%;
    top: 42%;
    --r: 110deg;
    --x1: -1.3rem;
    --y1: 4rem;
    animation-delay: -0.5s;
  }
  .destello:nth-child(6) {
    left: 28%;
    top: 88%;
    --r: -52deg;
    --x1: 3.3rem;
    --y1: -4.2rem;
    animation-delay: -3.7s;
  }

  /* --- Brillos pulsantes (patrón cosmoq de "Deep capabilities"): puntos
     de luz sobre el glow del anillo. --- */
  .fcard-brillos {
    inset: 0;
  }

  .brillo {
    position: absolute;
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 999px;
    background: var(--color-texto);
    box-shadow:
      0 0 0.75rem 0.25rem rgb(255 255 255 / 0.55),
      0 0 1.875rem 0.625rem rgb(255 107 53 / 0.25);
    animation: brillo-pulso 3s ease-in-out infinite;
  }

  .brillo:nth-child(1) {
    left: 22%;
    top: 22%;
  }
  .brillo:nth-child(2) {
    left: 78%;
    top: 28%;
    animation-delay: 0.8s;
  }
  .brillo:nth-child(3) {
    left: 20%;
    top: 76%;
    animation-delay: 1.6s;
  }
  .brillo:nth-child(4) {
    left: 80%;
    top: 74%;
    animation-delay: 2.2s;
  }

  @keyframes brillo-pulso {
    0%,
    100% {
      transform: scale(0.85);
      opacity: 0.75;
    }
    50% {
      transform: scale(1.1);
      opacity: 1;
    }
  }

  /* Medidas reales de cosmoq (.excep__row, contenedor ~1200px, gap 32px):
     fila 1 = 2 cards de 584x464px (aspect-ratio 1.26087/1), fila 2 = 3
     cards de 378x463px (aspect-ratio 0.81733/1) — ambas filas dan ~464px
     de alto pese a tener distinto número de columnas. */
  .fcard-visual--fila1 {
    min-height: 29rem;
  }

  .fcard-visual--fila2 {
    min-height: 29rem;
  }

  /* Texto flotante sobre la imagen/widget, inset del borde, con blur —
     el "gborder" de cosmoq (`.fcard__text`). Reserva ~90-100px abajo,
     ver min-height de arriba y el padding-bottom del widget de datos. */
  .fcard-texto {
    position: absolute;
    left: 1rem;
    right: 1rem;
    bottom: 1rem;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    padding: 1rem 1.25rem;
    border-radius: var(--radius-praxia);
    background: rgb(13 14 20 / 0.78);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid var(--color-linea);
  }

  /* Marco alrededor del antes/después tachado: sin esto, dos líneas de mono
     quedaban perdidas en una zona de visualización de ~10rem de alto.
     Ancho acotado en el card del radar para no montarse con el haz
     (ver `.fcard-visual:has(.radar) .tachado-caja` más abajo). */
  .tachado-caja {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    width: 100%;
    padding: 1.25rem;
    border: 1px solid rgb(84 124 255 / 0.16);
    border-radius: var(--radius-praxia);
    background: rgb(0 0 0 / 0.55);
    backdrop-filter: blur(2px);
    -webkit-backdrop-filter: blur(2px);
  }

  .tachado {
    text-decoration: line-through;
    text-decoration-color: var(--color-linea-viva);
    text-decoration-thickness: 1px;
  }

  /* --- Radar de visibilidad (pieza propia, no de cosmoq — misma técnica
     que Speed/Control: custom properties + keyframes, sin JS). Un haz
     gira 360° y tres "contactos" destellan cuando el haz los cruza:
     metáfora directa de "apareces cuando te buscan". Vive detrás de la
     caja de texto, se asoma por los bordes igual que el resto de los
     glows. --- */
  .radar {
    top: 0.75rem;
    right: 0.75rem;
    width: 6rem;
    height: 6rem;
  }

  /* La caja antes/después se acota y se va a la izquierda para dejar libre
     la esquina superior derecha, donde vive el radar. */
  .fcard-visual:has(.radar) .tachado-caja {
    max-width: 70%;
    padding: 1rem;
    margin-right: auto;
  }

  .radar-anillo {
    position: absolute;
    inset: 0;
    border-radius: 999px;
    border: 1px solid rgb(84 124 255 / 0.35);
  }

  .radar-anillo::before {
    content: '';
    position: absolute;
    inset: 1rem;
    border-radius: 999px;
    border: 1px solid rgb(84 124 255 / 0.25);
  }

  .radar-haz {
    position: absolute;
    inset: 0;
    border-radius: 999px;
    background: conic-gradient(from 0deg, rgb(255 107 53 / 0.55), transparent 30%);
    animation: radar-girar 4s linear infinite;
  }

  @keyframes radar-girar {
    to {
      transform: rotate(360deg);
    }
  }

  .radar-contacto {
    position: absolute;
    width: 0.375rem;
    height: 0.375rem;
    border-radius: 999px;
    background: var(--color-texto);
    animation: radar-contacto 4s linear infinite;
  }

  .radar-contacto:nth-child(3) {
    top: 18%;
    left: 62%;
    animation-delay: -0.33s;
  }
  .radar-contacto:nth-child(4) {
    top: 68%;
    left: 78%;
    animation-delay: -1.67s;
  }
  .radar-contacto:nth-child(5) {
    top: 74%;
    left: 22%;
    animation-delay: -2.67s;
  }

  @keyframes radar-contacto {
    0%,
    92%,
    100% {
      opacity: 0.25;
      transform: scale(0.8);
    }
    4% {
      opacity: 1;
      transform: scale(1.4);
    }
    12% {
      opacity: 0.3;
      transform: scale(0.8);
    }
  }

  /* --- Anillo giratorio: AUTO/PRES/IA/SEG alrededor de una P central. --- */
  .anillo {
    position: relative;
    height: 9rem;
    width: 9rem;
    display: grid;
    place-items: center;
  }

  .anillo-orbita {
    position: absolute;
    inset: 0;
    animation: girar 40s linear infinite;
  }

  .anillo-nodo {
    position: absolute;
    top: 50%;
    left: 50%;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    margin: -1.375rem;
    border-radius: 999px;
    border: 1px solid var(--color-linea-viva);
    background: var(--color-surface-2);
    font-size: 0.625rem;
    color: var(--color-texto-2);
    /* Distribuye los 4 nodos en un círculo de 3.75rem de radio y contra-gira
       cada uno para que el texto no quede de cabeza. --i se fija por
       :nth-child (abajo) en vez de un `style` inline: la CSP del sitio
       bloquea `style=""` dinámico (solo permite <style> en bloque, con
       hash). Siempre son 4 nodos (porque.ts: AUTO/PRES/IA/SEG). */
    transform: rotate(calc(var(--i) * 90deg)) translateX(3.75rem) rotate(calc(var(--i) * -90deg));
    animation: contra-girar 40s linear infinite;
  }

  .anillo-nodo:nth-child(1) {
    --i: 0;
  }
  .anillo-nodo:nth-child(2) {
    --i: 1;
  }
  .anillo-nodo:nth-child(3) {
    --i: 2;
  }
  .anillo-nodo:nth-child(4) {
    --i: 3;
  }

  .anillo-centro {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 999px;
    background: var(--color-brasa);
    color: var(--color-void);
    font-weight: 700;
    font-size: 0.9375rem;
  }

  @keyframes girar {
    to {
      transform: rotate(360deg);
    }
  }
  @keyframes contra-girar {
    from {
      transform: rotate(calc(var(--i) * 90deg)) translateX(3.75rem) rotate(calc(var(--i) * -90deg));
    }
    to {
      transform: rotate(calc(var(--i) * 90deg + 360deg)) translateX(3.75rem)
        rotate(calc(var(--i) * -90deg - 360deg));
    }
  }

  /* Las barras de "2 a 4 semanas" y los íconos de "Sobre lo que ya usas"
     ahora son islas de React (GlassWeeks / OrbitTools en src/components/ui,
     estilo Tailwind + shadcn) — ver TODO.md para el porqué. Sus estilos
     viven en los .tsx, no acá. */

  @media (prefers-reduced-motion: reduce) {
    .anillo-orbita,
    .anillo-nodo,
    .destello,
    .brillo,
    .radar-haz,
    .radar-contacto {
      animation: none;
    }

    .destello {
      opacity: 0;
    }

    .radar-contacto {
      opacity: 0.5;
    }

    /* Sin movimiento: la cinta se queda mostrando 15:00.000 fijo. El script
       ni siquiera arranca el rAF (ver el guard de reducido). */
    .crono-cinta {
      transition: none;
    }
  }
</style>

<script>
  /* Cronómetro de la card de diagnóstico: cuenta 15:00.000 hacia 0 y arranca
     cuando la card entra en viewport. Mismo patrón de observer que
     ChatMockup.astro (threshold + disconnect tras disparar una vez).

     Solo se anima transform de cada cinta: con los milisegundos refrescando a
     60fps, reescribir textContent forzaría relayout en cada frame. */
  const reducido = window.matchMedia('(prefers-reduced-motion: reduce)');
  const TOTAL_MS = 15 * 60 * 1000;

  document.querySelectorAll<HTMLElement>('[data-crono]').forEach((crono) => {
    const grupos = {
      mm: crono.querySelector<HTMLElement>('[data-crono-mm]'),
      ss: crono.querySelector<HTMLElement>('[data-crono-ss]'),
      ms: crono.querySelector<HTMLElement>('[data-crono-ms]'),
    };
    if (!grupos.mm || !grupos.ss || !grupos.ms) return;

    const cintas = (g: HTMLElement) =>
      Array.from(g.querySelectorAll<HTMLElement>('.crono-cinta'));
    const tiras = { mm: cintas(grupos.mm), ss: cintas(grupos.ss), ms: cintas(grupos.ms) };

    /* Cada cinta mide 10em de alto (diez numerales de 1em), así que el dígito
       n queda a -n em. Fraccionar ese desplazamiento da el deslizamiento
       continuo entre cifras en vez de un salto seco. */
    const colocar = (tira: HTMLElement[], valor: number, digitos: number, fluido: number) => {
      for (let i = digitos - 1; i >= 0; i--) {
        const div = Math.pow(10, digitos - 1 - i);
        const entero = Math.floor(valor / div) % 10;
        // solo el dígito menos significativo se desliza entre valores
        const desliz = i === digitos - 1 ? fluido : 0;
        tira[i].style.transform = `translateY(${-(entero + desliz)}em)`;
      }
    };

    const pintar = (restante: number) => {
      const mm = Math.floor(restante / 60000);
      const ss = Math.floor((restante % 60000) / 1000);
      const ms = Math.floor(restante % 1000);
      colocar(tiras.mm, mm, 2, 0);
      colocar(tiras.ss, ss, 2, 0);
      colocar(tiras.ms, ms, 3, 0);
    };

    pintar(TOTAL_MS);
    if (reducido.matches) return;

    let corriendo = false;
    const arrancar = () => {
      if (corriendo) return;
      corriendo = true;
      const t0 = performance.now();
      const paso = (ahora: number) => {
        const restante = Math.max(0, TOTAL_MS - (ahora - t0));
        pintar(restante);
        if (restante > 0) requestAnimationFrame(paso);
      };
      requestAnimationFrame(paso);
    };

    const observador = new IntersectionObserver(
      (entradas) => {
        entradas.forEach((entrada) => {
          if (!entrada.isIntersecting) return;
          observador.disconnect();
          arrancar();
        });
      },
      { threshold: 0.4 },
    );
    observador.observe(crono);
  });
</script>
