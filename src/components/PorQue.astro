---
import Seccion from './Seccion.astro';
import SectionLabel from './SectionLabel.astro';
import { PORQUE } from '../porque';
---

<Seccion id="por-que">
  <SectionLabel texto="Por qué Praxia" />
  <h2 class="mt-3 max-w-2xl revelar" data-retraso="1">Alcanzable para un negocio como el tuyo</h2>
  <p class="lead mt-5 max-w-2xl text-texto-2 revelar" data-retraso="2">
    No hace falta un área de tecnología ni un presupuesto de corporación. Hace falta saber qué
    quieres, y eso ya lo tienes.
  </p>

  <div class="bento mt-10">
    {
      PORQUE.map((t, i) => (
        <article
          class:list={['tarjeta bento-item revelar', `span-${t.span}`]}
          data-retraso={String(Math.min(3, (i % 3) + 1))}
        >
          <h3 class="text-[1.0625rem] font-semibold text-texto md:text-[1.1875rem]">{t.titulo}</h3>
          <p class="mt-2 text-[0.9375rem] text-texto-2">{t.texto}</p>

          {t.tipo === 'panel' && (
            <dl class="mt-5 divide-y divide-linea rounded-praxia border border-linea bg-void/40">
              {t.filas.map((f) => (
                <div class="flex items-center justify-between gap-3 px-4 py-2.5">
                  <dt class="pequeno text-texto-3">{f.clave}</dt>
                  <dd class="pequeno font-semibold text-texto">{f.valor}</dd>
                </div>
              ))}
            </dl>
          )}

          {t.tipo === 'anillo' && (
            <div class="anillo mt-6" aria-hidden="true">
              <div class="anillo-orbita">
                {t.nodos.map((n, ni) => (
                  <span class="anillo-nodo mono" style={`--i:${ni}`}>
                    {n}
                  </span>
                ))}
              </div>
              <span class="anillo-centro mono">P</span>
            </div>
          )}

          {t.tipo === 'tachado' && (
            <div class="mt-5 space-y-2 font-[family-name:var(--font-mono)] text-[0.8125rem]">
              <p class="tachado text-texto-3">«{t.antes}»</p>
              <p class="text-texto">«{t.despues}»</p>
            </div>
          )}

          {t.tipo === 'barras' && (
            <div class="mt-6 flex items-end gap-3" aria-hidden="true">
              {t.semanas.map((s, si) => (
                <div class="flex flex-1 flex-col items-center gap-2">
                  <div class="barra-pista">
                    <div class="revelar barra-relleno" data-retraso={String(si + 1)} />
                  </div>
                  <span class="mono text-[0.6875rem] text-texto-3">{s}</span>
                </div>
              ))}
            </div>
          )}

          {t.tipo === 'chips' && (
            <ul class="mt-5 flex flex-wrap gap-2">
              {t.chips.map((c) => (
                <li class="chip-mono">{c}</li>
              ))}
            </ul>
          )}
        </article>
      ))
    }
  </div>
</Seccion>

<style>
  .bento {
    display: grid;
    grid-template-columns: repeat(1, minmax(0, 1fr));
    gap: 1rem;
  }

  @media (min-width: 64rem) {
    .bento {
      grid-template-columns: repeat(12, minmax(0, 1fr));
    }
    .span-7 {
      grid-column: span 7 / span 7;
    }
    .span-5 {
      grid-column: span 5 / span 5;
    }
    .span-4 {
      grid-column: span 4 / span 4;
    }
  }

  .bento-item {
    display: flex;
    flex-direction: column;
  }

  .tachado {
    text-decoration: line-through;
    text-decoration-color: var(--color-linea-viva);
    text-decoration-thickness: 1px;
  }

  /* --- Anillo giratorio: WEB/SEO/IA/SEG alrededor de una P central. --- */
  .anillo {
    position: relative;
    height: 9rem;
    display: grid;
    place-items: center;
  }

  .anillo-orbita {
    position: absolute;
    inset: 0;
    animation: girar 40s linear infinite;
  }

  .anillo-nodo {
    position: absolute;
    top: 50%;
    left: 50%;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    margin: -1.375rem;
    border-radius: 999px;
    border: 1px solid var(--color-linea-viva);
    background: var(--color-surface-2);
    font-size: 0.625rem;
    color: var(--color-texto-2);
    /* Distribuye los 4 nodos en un círculo de 3.75rem de radio y contra-gira
       cada uno para que el texto no quede de cabeza. */
    transform: rotate(calc(var(--i) * 90deg)) translateX(3.75rem) rotate(calc(var(--i) * -90deg));
    animation: contra-girar 40s linear infinite;
  }

  .anillo-centro {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 999px;
    background: var(--color-brasa);
    color: var(--color-void);
    font-weight: 700;
    font-size: 0.9375rem;
  }

  @keyframes girar {
    to {
      transform: rotate(360deg);
    }
  }
  @keyframes contra-girar {
    from {
      transform: rotate(calc(var(--i) * 90deg)) translateX(3.75rem) rotate(calc(var(--i) * -90deg));
    }
    to {
      transform: rotate(calc(var(--i) * 90deg + 360deg)) translateX(3.75rem)
        rotate(calc(var(--i) * -90deg - 360deg));
    }
  }

  /* --- Barras de las semanas: crecen una sola vez, al revelarse. --- */
  .barra-pista {
    width: 100%;
    height: 3.5rem;
    border-radius: 0.25rem;
    background: var(--color-void);
    border: 1px solid var(--color-linea);
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }

  /* Sobrescribe la animación genérica de `.revelar` (opacidad + translateY):
     esta pieza crece desde abajo en vez de aparecer y desplazarse. */
  .revelar.barra-relleno {
    width: 100%;
    height: 30%;
    opacity: 1;
    background: var(--degradado-calido);
    transform-origin: bottom;
    transform: scaleY(0);
    transition: transform 700ms var(--ease-resorte);
  }

  .revelar.barra-relleno.visible {
    transform: scaleY(1);
  }

  @media (prefers-reduced-motion: reduce) {
    .anillo-orbita,
    .anillo-nodo {
      animation: none;
    }
  }
</style>
