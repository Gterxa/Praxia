---
import * as si from 'simple-icons';
import Seccion from './Seccion.astro';
import CabeceraSeccion from './CabeceraSeccion.astro';
import { GlassCalendar } from './ui/glass-calendar';
import { OrbitTools } from './ui/orbit-tools';
import CurvasCrecimiento from './CurvasCrecimiento.astro';
import CronoDiagnostico from './ui/crono-diagnostico';
import { PORQUE } from '../porque';
import { ruta } from '../rutas';

// Mismo patrón que Herramientas.astro: nombre de simple-icons -> trazo SVG.
const trazoIcono = (nombre?: string) => {
  if (!nombre) return null;
  const clave = `si${nombre[0]!.toUpperCase()}${nombre.slice(1)}` as keyof typeof si;
  const icono = si[clave] as { path: string } | undefined;
  return icono?.path ?? null;
};

// "Tu web" no es una marca, así que simple-icons no la cubre: va con un globo
// genérico (glifo "public" de Material Symbols, 24x24). Sin él, ese chip se
// caía de la órbita y quedaban 5 herramientas para 3 anillos — uno con una
// sola, visible la mitad del giro y vacío la otra mitad.
const TRAZO_WEB =
  'M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z';

// Fila 1 = los 2 ítems más anchos del bento original (span 7 y 5: panel y
// anillo), lado a lado. Fila 2 = los 3 span-4 restantes (tachado, barras,
// chips), en fila propia. Se filtra por `span` en vez de por índice fijo
// para no depender del orden exacto en porque.ts.
const filaAncha = PORQUE.filter((t) => t.span >= 5);
const filaAlta = PORQUE.filter((t) => t.span === 4);

// Glow de fondo por tarjeta (generado en la paleta de marca, ver
// public/porque/). Se reparten 3 assets entre las 5 tarjetas, igual que
// cosmoq reusa las suyas — no hace falta uno distinto por tarjeta.
const GLOW: Record<string, string> = {
  panel: 'glow-3.webp',
  anillo: 'glow-1.webp',
  tachado: 'glow-2.webp',
  barras: 'glow-1.webp',
  chips: 'glow-3.webp',
};
---

<Seccion id="por-que" class="seccion-cosmoq">
  <CabeceraSeccion etiqueta="Por qué Praxia" icono="check">
    <h2 slot="titulo" class="revelar" style="--i:0">Alcanzable para un negocio como el tuyo</h2>
    <p slot="subtitulo" class="lead revelar" style="--i:1">
      No hace falta un área de tecnología ni un presupuesto de corporación. Hace falta saber qué
      quieres, y eso ya lo tienes.
    </p>
  </CabeceraSeccion>

  <div class="mt-10 flex flex-col gap-6 lg:gap-8">
    <div class="flex flex-col gap-4 lg:flex-row lg:gap-6">
      {
        filaAncha.map((t, i) => (
          <article
            class:list={['tarjeta tarjeta-fcard min-w-0 flex-1 revelar-visual']}
            style={`--i:${i}`}
          >
            <div class="fcard-visual fcard-visual--fila1">
              <img src={ruta(`/porque/${GLOW[t.tipo]}`)} alt="" class="fcard-glow" aria-hidden="true" loading="lazy" />

              {t.tipo === 'panel' && (
                <>
                  <svg
                    class="fcard-lineas fcard-capa"
                    viewBox="0 0 578 462"
                    preserveAspectRatio="none"
                    aria-hidden="true"
                  >
                    <path
                      d="M 0 144 L 222 0 L 577.5 162.5 L 325.5 461.5 L 0 245 L 119 0 L 577.5 95.5 L 0 199 L 577.5 419 L 69.5 0 L 119 461.5 L 428 0 L 487.5 461.5"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1"
                    />
                  </svg>
                  <div class="fcard-destellos fcard-capa" aria-hidden="true">
                    <i class="destello" /><i class="destello destello--calido" />
                    <i class="destello" /><i class="destello destello--calido" />
                    <i class="destello" /><i class="destello destello--calido" />
                  </div>
                </>
              )}
              {t.tipo === 'panel' && <CronoDiagnostico client:visible />}

              {t.tipo === 'anillo' && (
                <div class="curva-crecimiento fcard-capa">
                  <CurvasCrecimiento />
                </div>
              )}

              <div class="fcard-texto">
                <h3 class="text-[1.0625rem] font-semibold text-texto md:text-[1.1875rem]">
                  {t.titulo}
                </h3>
                <p class="text-[0.9375rem] text-texto">{t.texto}</p>
              </div>
            </div>
          </article>
        ))
      }
    </div>

    <div class="flex flex-col gap-4 lg:flex-row lg:gap-6">
      {
        filaAlta.map((t, i) => (
          <article
            class:list={['tarjeta tarjeta-fcard min-w-0 flex-1 revelar-visual']}
            style={`--i:${i}`}
          >
            <div class="fcard-visual fcard-visual--fila2">
              <img src={ruta(`/porque/${GLOW[t.tipo]}`)} alt="" class="fcard-glow" aria-hidden="true" loading="lazy" />
              {t.tipo === 'tachado' && (
                <>
                  <div class="radar fcard-capa" aria-hidden="true">
                    <div class="radar-anillo" />
                    <div class="radar-haz" />
                    <i class="radar-contacto" /><i class="radar-contacto" /><i class="radar-contacto" />
                    <div class="gsc-logo">
                      <svg viewBox="0 0 40 40" width="100%" height="100%">
                        <g clip-path="url(#gsc-clip)">
                          <path
                            fill="#fbbc04"
                            d="m11.081 30.527-4.72 4.721a.933.933 0 0 1-1.317 0l-.292-.292a.933.933 0 0 1 0-1.316l4.72-4.721a.933.933 0 0 1 1.318 0l.291.291a.93.93 0 0 1 0 1.317"
                          />
                          <path
                            fill="#4285f4"
                            d="M23.75 32.5h6.042a6.04 6.04 0 0 0 6.041-6.042v-16.25a6.04 6.04 0 0 0-6.041-6.041 6.04 6.04 0 0 0-6.042 6.041z"
                          />
                          <path
                            fill="#fbbc04"
                            d="M13.75 32.5a6.04 6.04 0 0 0 6.042-6.042 6.04 6.04 0 0 0-6.042-6.041 6.04 6.04 0 0 0-6.042 6.041A6.04 6.04 0 0 0 13.75 32.5"
                          />
                          <path
                            fill="#34a853"
                            d="M27.97 32.5h-5.887a6.04 6.04 0 0 1-6.041-6.042v-7.916a6.04 6.04 0 0 1 6.041-6.042 6.04 6.04 0 0 1 6.042 6.042v13.804a.154.154 0 0 1-.154.154z"
                          />
                          <path
                            fill="#1967d2"
                            d="M28.125 32.346V18.542a6.04 6.04 0 0 0-4.375-5.807V32.5h4.22a.154.154 0 0 0 .155-.154"
                          />
                          <path
                            fill="#ea4335"
                            d="M19.792 26.575a6.04 6.04 0 0 0-3.75-5.59v5.59c0 1.72.72 3.273 1.875 4.373a6.02 6.02 0 0 0 1.875-4.373"
                          />
                        </g>
                        <defs>
                          <clipPath id="gsc-clip">
                            <path fill="#fff" d="M0 0h40v40H0z" />
                          </clipPath>
                        </defs>
                      </svg>
                    </div>
                  </div>
                </>
              )}

              {t.tipo === 'barras' && (
                <>
                  <svg
                    class="fcard-lineas fcard-capa"
                    viewBox="0 0 578 462"
                    preserveAspectRatio="none"
                    aria-hidden="true"
                  >
                    <path
                      d="M 0 144 L 222 0 L 577.5 162.5 L 325.5 461.5 L 0 245 L 119 0 L 577.5 95.5 L 0 199 L 577.5 419 L 69.5 0 L 119 461.5 L 428 0 L 487.5 461.5"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1"
                    />
                  </svg>
                  <div class="fcard-destellos fcard-capa" aria-hidden="true">
                    <i class="destello" /><i class="destello destello--calido" />
                    <i class="destello" /><i class="destello destello--calido" />
                  </div>
                  <GlassCalendar client:only="react" />
                </>
              )}

              {t.tipo === 'chips' && (
                <div class="orbit-capa fcard-capa">
                  <OrbitTools
                    herramientas={t.chips.map((c) => ({
                      nombre: c.nombre,
                      path: trazoIcono(c.icono) ?? TRAZO_WEB,
                    }))}
                  />
                </div>
              )}

              <div class="fcard-texto">
                <h3 class="text-[1.0625rem] font-semibold text-texto md:text-[1.1875rem]">
                  {t.titulo}
                </h3>
                <p class="text-[0.9375rem] text-texto">{t.texto}</p>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</Seccion>

<style>
  /* --- Estructura de tarjeta "fcard" (patrón real de cosmoq): un único
     contenedor donde la imagen/decoración llena toda la tarjeta y el texto
     flota encima con blur, cerca del borde inferior — no dos zonas
     apiladas separadas por una línea (eso era una desviación mía sin
     validar, corregida). Diferencia real con cosmoq: sus "patterns" son
     puramente decorativos (líneas, destellos, sliders); acá el widget
     (tabla, anillo, antes/después, barras, chips) SÍ es contenido, así que
     se ancla arriba (`align-items: flex-start`) para no pelear con el
     texto flotante de abajo — cosmoq no tiene ese problema porque no hay
     nada que anclar. */
  .tarjeta-fcard {
    padding: 0;
    overflow: hidden;
  }

  .fcard-visual {
    position: relative;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    width: 100%;
    padding: 1.75rem 1.5rem;

    /* Fundido común de las cinco cards: todo lo decorativo se apaga antes de
       llegar al panel de texto flotante, en vez de cruzar por detrás de él.
       Nació en la card de las órbitas (los íconos quedaban como manchas
       oscuras desenfocadas sobre el copy) y se extiende al resto para que las
       cinco tengan el mismo remate. Los porcentajes son del alto del card, así
       que solo sirve tal cual en capas a sangre (inset: 0); las que no lo son
       llevan su propia versión traducida a su caja (ver .curva-crecimiento). */
    --fcard-fundido: linear-gradient(to bottom, #000 46%, transparent 68%);
  }

  .fcard-lineas,
  .fcard-destellos {
    -webkit-mask-image: var(--fcard-fundido);
    mask-image: var(--fcard-fundido);
  }

  /* --- Glow de marca (patrón cosmoq: cada card trae su propio glow de
     fondo, contenido dentro del borde de la card, nunca de página —
     FondoOrbes.astro ya sacó el brillo global, esto es una aplicación
     acotada y distinta). Igual que cosmoq, es una imagen real (generada
     en la rampa "atardecer" de tokens.css, no el azul/naranja literal de
     cosmoq, ver public/porque/) y no un radial-gradient de CSS: una
     imagen prerenderizada tiene un desvanecido mucho más suave que
     cualquier gradiente en capas, sin bandas. El grano ya viene incluido
     en la imagen. --- */
  .fcard-glow {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
  }

  /* Capas decorativas (líneas, destellos, brillos, radar): absolutas y
     detrás del widget. Ojo con la especificidad: la regla del widget de
     abajo es (0,2,0) y pisa un `position: absolute` declarado en una clase
     sola (0,1,0) — por eso las capas se excluyen ahí explícitamente. */
  .fcard-capa {
    position: absolute;
    z-index: 0;
    pointer-events: none;
  }

  .fcard-visual > *:not(.fcard-glow):not(.fcard-capa):not(.fcard-texto) {
    position: relative;
    z-index: 1;
  }

  /* --- Malla de líneas + destellos (patrón cosmoq de la card "Speed"):
     wireframe geométrico decorativo detrás del panel de datos, más 6
     mini-estrellas fugaces que atraviesan la tarjeta. Geometría genérica,
     no es un asset de marca — colores sí son de tokens.css. --- */
  .fcard-lineas {
    inset: 0;
    width: 100%;
    height: 100%;
    color: var(--color-texto);
    opacity: 0.35;
  }

  .fcard-destellos {
    inset: 0;
    overflow: hidden;
  }

  /* --- Línea de tiempo de la llamada de diagnóstico. Vive entre el panel de
     datos y el copy flotante: la tabla dice QUÉ sale de la llamada, esto dice
     CÓMO se llega. Cada tramo crece según sus minutos (--lt-peso alimenta el
     flex-grow), así que los anchos salen del dato de porque.ts y no de
     porcentajes escritos a mano: cambiar un `min` ahí re-reparte la barra
     sola. --- */
  /* .fcard-visual es flex row: sin este wrapper, la tabla y el timeline se
     ponen lado a lado y la tabla se estruja a media caja (cada fila parte en
     dos líneas). Apilados en columna, la tabla recupera el ancho completo. */
  .panel-pila {
    display: flex;
    flex-direction: column;
    width: 100%;
    min-width: 0;
  }

  .fcard-visual--fila1 .fcard-lineas {
    opacity: 0.22;
  }

  /* Mobile (bajo el lg donde el bento pasa a fila): la tabla crece porque sus
     filas parten en dos líneas y empujan el timeline dentro de la zona que el
     --fcard-fundido apaga, así que las etiquetas quedaban invisibles. Se deja
     solo la barra segmentada —que ya comunica la proporción por sí sola— y el
     texto se mantiene accesible en el aria-label de cada tramo. */
  @media (width < 64rem) {
    /* .fcard-texto es absolute anclado al fondo (bottom:1rem, z-index:2) y en
       mobile crece a cuatro líneas, así que pasaba por encima del timeline,
       que va en flujo. El padding le reserva la banda que ocupa ese panel:
       ~11rem de copy + su inset. No es el --fcard-fundido, que solo enmascara
       las capas decorativas a sangre. */
    /* El panel de texto (absolute, bottom:1rem) mide ~206px en mobile y
       arrancaba a 0.5px del timeline, tapándolo entero. Medido en el DOM a
       390px: tabla termina en 2196, timeline 2208-2212, panel 2208-2415.
       El timeline sube por encima de esa banda con un margen propio; el
       padding en .panel-pila no servía porque crece hacia abajo, no empuja
       el contenido hacia arriba. */
    .linea-tiempo {
      margin-bottom: 13rem;
    }

    .lt-etapa,
    .lt-min {
      /* clip, no display:none: el lector de pantalla sigue llegando al
         aria-label del tramo, que es donde vive el dato en esta versión. */
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    .linea-tiempo {
      margin-top: 0.75rem;
    }

    .lt-barra {
      height: 4px;
    }
  }

  .destello {
    position: absolute;
    width: 0.875rem;
    height: 2px;
    border-radius: 999px;
    background: linear-gradient(90deg, var(--color-linea-viva) 0%, var(--color-texto) 100%);
    animation: destello-cruzar 6s linear infinite;
  }

  .destello--calido {
    background: linear-gradient(90deg, var(--color-brasa) 0%, var(--color-texto) 100%);
  }

  @keyframes destello-cruzar {
    0% {
      transform: translate(var(--x0, 0), var(--y0, 0)) rotate(var(--r, 0deg));
      opacity: 0;
    }
    10%,
    90% {
      opacity: 1;
    }
    100% {
      transform: translate(var(--x1, 0), var(--y1, 0)) rotate(var(--r, 0deg));
      opacity: 0;
    }
  }

  .destello:nth-child(1) {
    left: 15%;
    top: 8%;
    --r: 12deg;
    --x1: 4rem;
    --y1: 1rem;
    animation-delay: -1s;
  }
  .destello:nth-child(2) {
    left: 68%;
    top: 10%;
    --r: 60deg;
    --x1: 2rem;
    --y1: 3.6rem;
    animation-delay: -3s;
  }
  .destello:nth-child(3) {
    left: 82%;
    top: 78%;
    --r: -70deg;
    --x1: -1rem;
    --y1: -3rem;
    animation-delay: -2s;
  }
  .destello:nth-child(4) {
    left: 12%;
    top: 60%;
    --r: -33deg;
    --x1: 4.6rem;
    --y1: -3rem;
    animation-delay: -4.5s;
  }
  .destello:nth-child(5) {
    left: 48%;
    top: 42%;
    --r: 110deg;
    --x1: -1.3rem;
    --y1: 4rem;
    animation-delay: -0.5s;
  }
  .destello:nth-child(6) {
    left: 28%;
    top: 88%;
    --r: -52deg;
    --x1: 3.3rem;
    --y1: -4.2rem;
    animation-delay: -3.7s;
  }

  /* --- Constelaciones de crecimiento (SVG inline, en
     CurvasCrecimiento.astro). Ocupa la franja entre el tope de la card y el
     panel de texto, que en mobile envuelve una línea más y crece hacia arriba.
     Sin ejes ni cifras a propósito — el porqué está en el componente. --- */
  .curva-crecimiento {
    top: 1.25rem;
    right: 0;
    left: 0;
    bottom: 8.75rem;
  }

  /* Medidas reales de cosmoq (.excep__row, contenedor ~1200px, gap 32px):
     fila 1 = 2 cards de 584x464px (aspect-ratio 1.26087/1), fila 2 = 3
     cards de 378x463px (aspect-ratio 0.81733/1) — ambas filas dan ~464px
     de alto pese a tener distinto número de columnas. */
  .fcard-visual--fila1 {
    min-height: 29rem;
  }

  .fcard-visual--fila2 {
    min-height: 29rem;
  }

  /* Texto flotante sobre la imagen/widget — réplica exacta de `.fcard__text`
     + `.gborder` de cosmoq: SIN background-color propio, solo blur(5px) y un
     borde blanco enmascarado (visible ~12-23% en el medio, se apaga en las
     puntas) que imita el reflejo del canto del vidrio. Antes llevaba un
     fondo casi opaco (0.78 de alpha) que lo volvía una tarjeta plana en vez
     de vidrio — cosmoq real no tiene ningún fill, confirmado en su CSS. */
  .fcard-texto {
    position: absolute;
    left: 1rem;
    right: 1rem;
    bottom: 1rem;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    padding: 1.25rem;
    border-radius: var(--radius-praxia);
    overflow: clip;
    backdrop-filter: blur(5px);
    -webkit-backdrop-filter: blur(5px);
  }

  .fcard-texto::before {
    content: '';
    position: absolute;
    inset: 0;
    border: 1px solid #fff;
    border-radius: inherit;
    pointer-events: none;
    -webkit-mask-image: linear-gradient(
      255deg,
      transparent 0%,
      rgb(0 0 0 / 0.12) 18.17%,
      rgb(0 0 0 / 0.23) 85.17%,
      transparent 100%
    );
    mask-image: linear-gradient(
      255deg,
      transparent 0%,
      rgb(0 0 0 / 0.12) 18.17%,
      rgb(0 0 0 / 0.23) 85.17%,
      transparent 100%
    );
  }

  /* --- Radar de visibilidad (pieza propia, no de cosmoq — misma técnica
     que Speed/Control: custom properties + keyframes, sin JS). Un haz
     gira 360° y tres "contactos" destellan cuando el haz los cruza:
     metáfora directa de "apareces cuando te buscan". --- */
  .radar {
    top: 34%;
    left: 50%;
    width: 76%;
    aspect-ratio: 1;
    transform: translate(-50%, -50%);
  }

  /* Logo de Google Search Console en el centro del radar — reemplaza el
     antes/después de texto (dejó de hacer falta explicarlo con palabras: el
     haz barriendo alrededor del logo ya dice "apareces cuando te buscan").
     Colores oficiales de marca, no son la paleta de Tailwind que prohíbe el
     guardrail. z-index para quedar por delante del haz que gira. */
  .gsc-logo {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 1;
    width: 30%;
    aspect-ratio: 1;
    transform: translate(-50%, -50%);
  }

  .radar-anillo {
    position: absolute;
    inset: 0;
    border-radius: 999px;
    border: 1px solid rgb(84 124 255 / 0.35);
  }

  .radar-anillo::before {
    content: '';
    position: absolute;
    inset: 17%;
    border-radius: 999px;
    border: 1px solid rgb(84 124 255 / 0.25);
  }

  .radar-haz {
    position: absolute;
    inset: 0;
    border-radius: 999px;
    background: conic-gradient(from 0deg, rgb(255 107 53 / 0.55), transparent 30%);
    animation: radar-girar 4s linear infinite;
  }

  @keyframes radar-girar {
    to {
      transform: rotate(360deg);
    }
  }

  .radar-contacto {
    position: absolute;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 999px;
    background: var(--color-texto);
    animation: radar-contacto 4s linear infinite;
  }

  .radar-contacto:nth-child(3) {
    top: 18%;
    left: 62%;
    animation-delay: -0.33s;
  }
  .radar-contacto:nth-child(4) {
    top: 68%;
    left: 78%;
    animation-delay: -1.67s;
  }
  .radar-contacto:nth-child(5) {
    top: 74%;
    left: 22%;
    animation-delay: -2.67s;
  }

  @keyframes radar-contacto {
    0%,
    92%,
    100% {
      opacity: 0.25;
      transform: scale(0.8);
    }
    4% {
      opacity: 1;
      transform: scale(1.4);
    }
    12% {
      opacity: 0.3;
      transform: scale(0.8);
    }
  }

  /* El calendario de "2 a 4 semanas" y los íconos de "Sobre lo que ya usas"
     son islas de React (GlassCalendar / OrbitTools en src/components/ui,
     estilo Tailwind + shadcn) — ver TODO.md para el porqué. Sus estilos
     viven en los .tsx, no acá. GlassCalendar entra como `client:only`
     porque calcula fechas reales: en un sitio estático, un render de build
     congelaría el "próximo lunes" a la fecha del deploy.

     OrbitTools va en una capa a sangre (no en el flujo, como estaba): sus
     anillos se salen del card a propósito y el recorte lo pone el
