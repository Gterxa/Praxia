---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { NAV_PRINCIPAL } from '../consts';

const ruta = Astro.url.pathname.replace(/\/$/, '') || '/';
const esActiva = (href: string) => ruta === href || ruta.startsWith(`${href}/`);
---

<header class="sticky top-0 z-40 border-b border-linea bg-void">
  <div class="contenedor flex h-16 items-center justify-between gap-4 md:h-20">
    <a href="/" class="rounded-sm" aria-label="Praxia, ir al inicio">
      <Logo />
    </a>

    <nav class="hidden items-center gap-7 lg:flex" aria-label="Principal">
      {
        NAV_PRINCIPAL.map((item) => (
          <a
            href={item.href}
            class:list={[
              'nav-enlace pequeno font-medium transition-colors hover:text-brasa',
              esActiva(item.href) ? 'text-brasa' : 'text-texto',
            ]}
            aria-current={esActiva(item.href) ? 'page' : undefined}
          >
            {item.texto}
          </a>
        ))
      }
      <a
        href="/precios"
        class="boton boton-secundario boton-compacto hidden xl:inline-flex"
        aria-current={esActiva('/precios') ? 'page' : undefined}
      >
        Ver precios
      </a>
      <a href="/diagnostico" class="boton boton-primario boton-compacto">
        Agenda tu diagnóstico
      </a>
    </nav>

    <button
      type="button"
      id="boton-menu"
      class="-mr-2 inline-flex items-center justify-center rounded-praxia p-2 text-texto lg:hidden"
      aria-expanded="false"
      aria-controls="menu-movil"
    >
      <span class="sr-only">Abrir menú</span>
      <Icon nombre="menu" tamano={26} class="[[aria-expanded=true]_&]:hidden" />
      <Icon nombre="cerrar" tamano={26} class="hidden [[aria-expanded=true]_&]:block" />
    </button>
  </div>

  <div id="menu-movil" class="hidden border-t border-linea bg-void lg:hidden">
    <nav class="contenedor flex flex-col py-3" aria-label="Principal, celular">
      {
        NAV_PRINCIPAL.map((item) => (
          <a
            href={item.href}
            class:list={[
              'border-b border-linea py-3.5 font-medium',
              esActiva(item.href) ? 'text-brasa' : 'text-texto',
            ]}
            aria-current={esActiva(item.href) ? 'page' : undefined}
          >
            {item.texto}
          </a>
        ))
      }
      <a
        href="/precios"
        class:list={[
          'border-b border-linea py-3.5 font-medium',
          esActiva('/precios') ? 'text-brasa' : 'text-texto',
        ]}
        aria-current={esActiva('/precios') ? 'page' : undefined}
      >
        Precios
      </a>
      <a href="/diagnostico" class="boton boton-primario mt-4 mb-2 w-full">
        Agenda tu diagnóstico
      </a>
    </nav>
  </div>
</header>

<style>
  /* Subrayado que crece desde la izquierda: hover y página activa. */
  .nav-enlace {
    position: relative;
    padding-block: 0.25rem;
  }

  .nav-enlace::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.125rem;
    height: 1.5px;
    background-color: var(--color-brasa);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 150ms ease;
  }

  .nav-enlace:hover::after,
  .nav-enlace[aria-current='page']::after {
    transform: scaleX(1);
  }
</style>

<script>
  const boton = document.getElementById('boton-menu');
  const menu = document.getElementById('menu-movil');

  if (boton && menu) {
    const cerrar = () => {
      boton.setAttribute('aria-expanded', 'false');
      menu.classList.add('hidden');
    };

    boton.addEventListener('click', () => {
      const abierto = boton.getAttribute('aria-expanded') === 'true';
      boton.setAttribute('aria-expanded', String(!abierto));
      menu.classList.toggle('hidden', abierto);
    });

    document.addEventListener('keydown', (evento) => {
      if (evento.key === 'Escape' && boton.getAttribute('aria-expanded') === 'true') {
        cerrar();
        boton.focus();
      }
    });

    // Si la pantalla crece, el menú de celular no debe quedar abierto.
    window.matchMedia('(min-width: 64rem)').addEventListener('change', (e) => {
      if (e.matches) cerrar();
    });
  }
</script>
