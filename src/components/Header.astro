---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { NAV_PRINCIPAL } from '../consts';
import { ruta, sinBase } from '../rutas';

const rutaActual = sinBase(Astro.url.pathname);
const esActiva = (href: string) => rutaActual === href || rutaActual.startsWith(`${href}/`);
---

<header class="sticky top-0 z-40 px-4 pt-(--header-aire) pointer-events-none md:px-6">
  <div class="contenedor relative max-w-[68rem]! px-0!">
    <div class="vidrio pointer-events-auto relative flex h-(--header-pill) items-center justify-between gap-4 rounded-pill px-3 pr-2 md:px-5 md:pr-3">
      <a href={ruta('/')} class="rounded-sm py-1 pl-1" aria-label="Praxia, ir al inicio">
        <Logo />
      </a>

      <nav class="hidden items-center gap-6 lg:flex" aria-label="Principal">
        {
          NAV_PRINCIPAL.map((item) => (
            <a
              href={ruta(item.href)}
              class:list={[
                'nav-enlace pequeno font-medium transition-colors hover:text-brasa',
                esActiva(item.href) ? 'text-brasa' : 'text-texto',
              ]}
              aria-current={esActiva(item.href) ? 'page' : undefined}
            >
              {item.texto}
            </a>
          ))
        }
      </nav>

      <div class="flex items-center gap-2">
        <a href={ruta('/validar')} class="boton boton-primario boton-compacto inline-flex">
          Validar mi idea
        </a>

        <button
          type="button"
          id="boton-menu"
          class="-mr-1 inline-flex min-h-11 min-w-11 items-center justify-center rounded-pill p-2 text-texto lg:hidden"
          aria-expanded="false"
          aria-controls="menu-movil"
        >
          <span class="sr-only">Abrir menú</span>
          <Icon nombre="menu" tamano={24} class="[[aria-expanded=true]_&]:hidden" />
          <Icon nombre="cerrar" tamano={24} class="hidden [[aria-expanded=true]_&]:block" />
        </button>
      </div>

      <!-- Veta de luz sobre el borde del pill, con un tramo transparente
           donde no debe brillar (truco de la réplica de cosmoq). -->
      <div class="borde-luz" aria-hidden="true"></div>
    </div>

    {/*
      absolute, no en el flujo: el <header> es sticky y ocupa alto real, así que
      un menú en flujo lo hacía crecer de 72px a ~326px al abrirse y empujaba el
      hero 254px hacia abajo (el título y los botones "saltaban"). Flotando sobre
      el contenido, abrir y cerrar no mueve nada.
    */}
    <div
      id="menu-movil"
      class="vidrio pointer-events-auto absolute inset-x-0 top-full z-50 mt-2 hidden rounded-[1.5rem] p-2 lg:hidden"
    >
      <nav class="flex flex-col" aria-label="Principal, celular">
        {
          NAV_PRINCIPAL.map((item) => (
            <a
              href={ruta(item.href)}
              class:list={[
                'rounded-praxia px-4 py-3.5 font-medium',
                esActiva(item.href) ? 'text-brasa' : 'text-texto',
              ]}
              aria-current={esActiva(item.href) ? 'page' : undefined}
            >
              {item.texto}
            </a>
          ))
        }
      </nav>
    </div>
  </div>
</header>

<style>
  /* Alto real del header, expuesto como variable: HeroHome.astro y el banco
     de pruebas lo usan para meter el hero debajo del header (margin-top
     negativo) sin duplicar estos números a mano y arriesgarse a que
     diverjan. --alto-header = aire por arriba + alto de la pill. */
  :global(:root) {
    --header-aire: 1rem; /* antes pt-4 */
    --header-pill: 3.5rem; /* antes h-14 */
    --alto-header: calc(var(--header-aire) + var(--header-pill));
  }

  /* md de Tailwind (48rem), sin redefinir en tokens.css. */
  @media (min-width: 48rem) {
    :global(:root) {
      --header-aire: 1.125rem; /* antes md:pt-[18px] */
      --header-pill: 4rem; /* antes md:h-16 */
    }
  }

  /* Subrayado que crece desde la izquierda: hover y página activa. */
  .nav-enlace {
    position: relative;
    padding-block: 0.25rem;
  }

  .nav-enlace::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.125rem;
    height: 1.5px;
    background-color: var(--color-brasa);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 400ms var(--ease-resorte);
  }

  .nav-enlace[aria-current='page']::after {
    transform: scaleX(1);
  }

  @media (hover: hover) and (pointer: fine) {
    .nav-enlace:hover::after {
      transform: scaleX(1);
    }
  }

  /* Veta de luz sobre el borde del pill: un borde blanco enmascarado que deja
     un tramo transparente en el medio, no un `border` sólido. */
  .borde-luz {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    border: 1px solid #fff;
    pointer-events: none;
    mask-image: linear-gradient(160deg, #000 0%, transparent 39%, transparent 69%, #000 100%);
    -webkit-mask-image: linear-gradient(160deg, #000 0%, transparent 39%, transparent 69%, #000 100%);
    opacity: 0.5;
  }
</style>

<script>
  const boton = document.getElementById('boton-menu');
  const menu = document.getElementById('menu-movil');

  if (boton && menu) {
    const cerrar = () => {
      boton.setAttribute('aria-expanded', 'false');
      menu.classList.add('hidden');
    };

    boton.addEventListener('click', () => {
      const abierto = boton.getAttribute('aria-expanded') === 'true';
      boton.setAttribute('aria-expanded', String(!abierto));
      menu.classList.toggle('hidden', abierto);
    });

    document.addEventListener('keydown', (evento) => {
      if (evento.key === 'Escape' && boton.getAttribute('aria-expanded') === 'true') {
        cerrar();
        boton.focus();
      }
    });

    // Si la pantalla crece, el menú de celular no debe quedar abierto.
    window.matchMedia('(min-width: 64rem)').addEventListener('change', (e) => {
      if (e.matches) cerrar();
    });
  }
</script>
