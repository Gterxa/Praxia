---
/**
 * Cierre de la home: la llamada a validar, con lo que se lleva el visitante.
 * El wizard completo de 4 pasos vive en /validar (evita duplicar un
 * formulario con estado en dos lugares de la misma página).
 *
 * Layout "integration" de cosmoq (dos columnas: promesas + CTA a la
 * izquierda, grilla 3×2 de capacidades a la derecha), paleta Praxia. La
 * grilla usa las 6 capacidades reales (src/content/capacidades), no íconos
 * decorativos inventados.
 */
import Icon from './Icon.astro';
import Seccion from './Seccion.astro';
import CabeceraSeccion from './CabeceraSeccion.astro';
import { waLink, CONTEXTO } from '../consts';
import { ruta } from '../rutas';
import { getCapacidades } from '../capacidades';

const PROMESAS = [
  'Precio y plazo estimados',
  'Viabilidad honesta: sí, no o aún no',
  'Diagrama del flujo que propondríamos',
  'Qué automatizar primero',
] as const;

const capacidades = await getCapacidades();
---

<Seccion id="validar" class="seccion-cosmoq" fondo="acento">
  <div class="grid gap-10 lg:grid-cols-2 lg:items-center lg:gap-20">
    <div class="flex flex-col gap-10 lg:gap-12">
      <CabeceraSeccion etiqueta="Validemos tu idea" icono="check" apilada>
        <h2 slot="titulo" class="revelar" style="--i:0">Cuéntanos qué quieres automatizar.</h2>
        <p slot="subtitulo" class="revelar" style="--i:1">
          Cuatro pasos cortos. Te respondemos el mismo día con una hora para los 15 minutos.
        </p>
      </CabeceraSeccion>

      <ul class="grid gap-3 sm:grid-cols-2">
        {
          PROMESAS.map((p) => (
            <li class="item-check">
              <span class="item-check-marca">
                <Icon nombre="check" tamano={13} />
              </span>
              <p>{p}</p>
            </li>
          ))
        }
      </ul>

      <div class="flex flex-col gap-3 sm:flex-row">
        <a href={ruta('/validar')} class="boton boton-primario">Validemos en 15 minutos</a>
        <a href={waLink(CONTEXTO.cierre)} target="_blank" rel="noopener" class="boton boton-secundario">
          <Icon nombre="whatsapp" tamano={20} />
          WhatsApp
        </a>
      </div>
    </div>

    <div class="flex justify-center lg:justify-end">
      <div class="cierre-grilla">
        {
          capacidades.map((c) => (
            <div class="cierre-capacidad">
              <div class="gicon">
                <div class="gicon-adentro">
                  <Icon nombre={c.data.icono} tamano={28} />
                </div>
              </div>
              <span class="cierre-capacidad-nombre text-texto-2">{c.data.nombreCorto}</span>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</Seccion>

<style>
  .cierre-grilla {
    display: grid;
    grid-template-columns: repeat(3, auto);
    gap: 2rem 1.75rem;
    max-width: 22rem;
  }

  .cierre-capacidad {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    text-align: center;
  }

  .cierre-capacidad-nombre {
    font-size: 0.8125rem;
    line-height: 1.3;
  }
</style>
