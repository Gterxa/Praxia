---
/** Bandera del idioma en SVG (los emoji de bandera no se dibujan en Windows). */
import type { Idioma } from '../../i18n/funnel';

interface Props {
  id: Idioma;
}
const { id } = Astro.props;
---

{
  id === 'es' ? (
    <svg class="si-bandera" viewBox="0 0 18 12" aria-hidden="true">
      <rect width="18" height="12" fill="#fff" />
      <rect width="6" height="12" fill="#d91023" />
      <rect x="12" width="6" height="12" fill="#d91023" />
    </svg>
  ) : (
    <svg class="si-bandera" viewBox="0 0 19 10" preserveAspectRatio="none" aria-hidden="true">
      <rect width="19" height="10" fill="#b22234" />
      {[1, 3, 5, 7, 9, 11].map((n) => <rect y={(n * 10) / 13} width="19" height={10 / 13} fill="#fff" />)}
      <rect width="7.6" height={(7 * 10) / 13} fill="#3c3b6e" />
    </svg>
  )
}
