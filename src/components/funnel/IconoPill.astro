---
/**
 * Ícono blanco de cada pill del hero del funnel, en el mismo orden que
 * `landing.pills` (src/i18n/funnel.ts): WhatsApp, cotizaciones, citas,
 * reportes y web. WhatsApp es la marca (simple-icons); el resto son trazos de
 * Lucide copiados en línea para no cargar una librería por cinco íconos.
 */
import { siWhatsapp } from 'simple-icons';

interface Props {
  i: number;
}
const { i } = Astro.props;
---

{
  i === 0 ? (
    <svg class="fl-pill-icono" width="16" height="16" viewBox="0 0 24 24" aria-hidden="true">
      <path d={siWhatsapp.path} fill="currentColor" />
    </svg>
  ) : (
    <svg class="fl-pill-icono" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      {i === 1 && (
        <>
          <path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z" />
          <path d="M14 2v4a2 2 0 0 0 2 2h4" />
          <path d="M10 9H8" />
          <path d="M16 13H8" />
          <path d="M16 17H8" />
        </>
      )}
      {i === 2 && (
        <>
          <rect width="18" height="18" x="3" y="4" rx="2" />
          <path d="M16 2v4" />
          <path d="M8 2v4" />
          <path d="M3 10h18" />
          <path d="m9 16 2 2 4-4" />
        </>
      )}
      {i === 3 && (
        <>
          <path d="M3 3v16a2 2 0 0 0 2 2h16" />
          <path d="M18 17V9" />
          <path d="M13 17V5" />
          <path d="M8 17v-3" />
        </>
      )}
      {i === 4 && (
        <>
          <circle cx="12" cy="12" r="10" />
          <path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20" />
          <path d="M2 12h20" />
        </>
      )}
    </svg>
  )
}

<style>
  .fl-pill-icono {
    width: 1rem;
    height: 1rem;
    color: #fff;
    flex-shrink: 0;
  }
</style>
