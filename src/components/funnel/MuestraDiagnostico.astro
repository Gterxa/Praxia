---
/**
 * Tarjeta "Ejemplo de diagnóstico": el formato del entregable con un negocio
 * ficticio (mecánica de la tarjeta de auditoría de rankhive.co). Lleva la
 * etiqueta "Ejemplo" igual que los chats de ejemplo del sitio: no es un caso.
 * La grilla es la versión mínima del mapa de calor de Google Maps.
 * Datos en MUESTRA_DIAGNOSTICO (src/vsl.ts).
 */
import { MUESTRA_DIAGNOSTICO as M } from '../../vsl';

const ESTADOS = {
  resolver: { texto: 'Por resolver', clase: 'estado-resolver' },
  bien: { texto: 'Bien', clase: 'estado-bien' },
} as const;

const visibles = M.mapa.filter((p) => p === 1).length;
---

<article class="tarjeta muestra p-0!" aria-label="Ejemplo de diagnóstico con un negocio ficticio">
  <header class="flex items-start justify-between gap-4 border-b border-linea p-5 md:p-6">
    <div>
      <p class="pequeno text-texto-3">Diagnóstico</p>
      <p class="mt-1 font-[family-name:var(--font-titulos)] text-[1.125rem] font-semibold text-texto">{M.negocio}</p>
    </div>
    <span class="chip-mono">Ejemplo</span>
  </header>

  <div class="grid gap-5 border-b border-linea p-5 sm:grid-cols-[auto_1fr] sm:items-center md:p-6">
    <div class="mapa" role="img" aria-label={`Mapa de la zona: apareces en ${visibles} de ${M.mapa.length} puntos`}>
      {M.mapa.map((p) => <span class:list={['mapa-punto', p === 1 && 'mapa-punto--si']} />)}
    </div>
    <div>
      <p class="font-[family-name:var(--font-titulos)] text-[2rem] leading-none font-bold text-texto">
        {visibles}<span class="text-[1.125rem] font-medium text-texto-3"> de {M.mapa.length}</span>
      </p>
      <p class="pequeno mt-2 text-texto-2">puntos de tu zona donde apareces entre los tres primeros de Google Maps</p>
    </div>
  </div>

  <ul class="divide-y divide-linea">
    {
      M.areas.map((a) => (
        <li class="flex items-start justify-between gap-4 px-5 py-3.5 md:px-6">
          <div class="min-w-0">
            <p class="text-texto">{a.area}</p>
            <p class="pequeno text-texto-3">{a.dato}</p>
          </div>
          <span class:list={['estado', ESTADOS[a.estado].clase]}>{ESTADOS[a.estado].texto}</span>
        </li>
      ))
    }
  </ul>

  <footer class="border-t border-linea p-5 md:p-6">
    <p class="pequeno text-texto-3">Lo primero</p>
    <p class="mt-1 text-texto">{M.primero}</p>
  </footer>
</article>

<style>
  .muestra {
    overflow: hidden;
  }

  .mapa {
    display: grid;
    grid-template-columns: repeat(5, 0.875rem);
    gap: 0.5rem;
  }

  .mapa-punto {
    width: 0.875rem;
    height: 0.875rem;
    border-radius: 999px;
    background-color: var(--color-surface-2);
    box-shadow: inset 0 0 0 1px var(--color-linea);
  }

  .mapa-punto--si {
    background-color: var(--color-cian);
    box-shadow: 0 0 0 3px rgb(53 224 212 / 0.16);
  }

  .estado {
    flex: none;
    padding: 0.25rem 0.625rem;
    border-radius: var(--radius-pill);
    font-size: 0.8125rem;
    font-weight: 500;
    white-space: nowrap;
  }

  .estado-resolver {
    color: var(--color-ambar);
    background-color: rgb(245 166 35 / 0.12);
  }

  .estado-bien {
    color: var(--color-verde);
    background-color: rgb(61 220 151 / 0.12);
  }
</style>
