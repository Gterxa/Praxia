---
import ChatMockup from './ChatMockup.astro';
import Seccion from './Seccion.astro';
import CabeceraSeccion from './CabeceraSeccion.astro';
import { INDUSTRIAS } from '../industrias';
---

<Seccion id="industrias" class="seccion-cosmoq" fondo="surface">
  <CabeceraSeccion etiqueta="Industrias" icono="personas">
    <h2 slot="titulo" class="revelar" data-retraso="1">¿Y si no funciona en mi rubro?</h2>
    <p slot="subtitulo" class="lead text-texto-2 revelar" data-retraso="2">
      Once rubros donde ya sabemos qué automatizar primero. Elige el tuyo.
    </p>
  </CabeceraSeccion>

  <div class="mt-10" data-industrias>
    <div
      class="chips-pista -mx-5 flex gap-2 overflow-x-auto px-5 pb-2 md:mx-0 md:flex-wrap md:justify-center md:overflow-visible md:px-0"
      role="tablist"
      aria-label="Rubros de negocio"
    >
      {
        INDUSTRIAS.map((r, i) => (
          <button
            type="button"
            role="tab"
            id={`rubro-tab-${r.id}`}
            aria-controls={`rubro-panel-${r.id}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
            class="pestana-pill flex-none"
          >
            {r.nombre}
          </button>
        ))
      }
    </div>

    {
      INDUSTRIAS.map((r, i) => (
        <div
          role="tabpanel"
          id={`rubro-panel-${r.id}`}
          aria-labelledby={`rubro-tab-${r.id}`}
          hidden={i !== 0}
          class="tarjeta panel-rubro mt-6 p-6 md:p-10"
        >
          <div class="grid gap-8 md:grid-cols-[1.1fr_1fr] md:items-center md:gap-14">
            <div>
              <h3 class="text-[1.1875rem] font-semibold text-texto md:text-[1.375rem]">{r.nombre}</h3>
              <p class="mt-3 text-texto-2">{r.blurb}</p>
              <p class="mono mt-6 text-texto-3">Lo primero que automatizaríamos</p>
              <ol class="mt-4 flex flex-col gap-3 md:max-w-[26rem]">
                {r.lineas.map((linea, li) => (
                  <li class="item-check">
                    <span class="item-check-marca item-check-marca--numero">
                      {String(li + 1).padStart(2, '0')}
                    </span>
                    <p>{linea}</p>
                  </li>
                ))}
              </ol>
            </div>
            <div>
              <p class="mono mb-3 text-texto-3">Así se ve funcionando</p>
              <ChatMockup negocio={r.nombre} mensajes={r.demo} class="max-w-none!" />
            </div>
          </div>
        </div>
      ))
    }
  </div>
</Seccion>

<style>
  .chips-pista::-webkit-scrollbar {
    display: none;
  }
  .chips-pista {
    scrollbar-width: none;
  }

  .panel-rubro {
    background: linear-gradient(180deg, rgb(255 107 53 / 0.08), rgb(255 107 53 / 0.02));
  }

  /* Borde del panel `pcontent` de cosmoq: nunca --color-linea gris plano,
     siempre la línea tenue con tinte de --color-linea-viva (ver
     CabeceraSeccion .cabecera-linea, mismo valor). */
  .panel-rubro::after {
    border-color: rgb(84 124 255 / 0.16);
  }

  /* Número dentro de la píldora del check, en vez del ícono: mismo acento
     brasa que tenía la lista numerada original. */
  .item-check-marca--numero {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--color-brasa);
  }

  @media (min-width: 48rem) {
    /* Min-height generoso del panel `pcontent` de cosmoq: solo en desktop,
       donde las dos columnas comparten alto y si no el panel queda
       apretado contra el mockup de chat. En mobile el stack ya es más alto
       que esto, así que no hace falta. */
    .panel-rubro {
      min-height: 28rem;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-industrias]').forEach((grupo) => {
    const pestanas = Array.from(grupo.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const paneles = Array.from(grupo.querySelectorAll<HTMLElement>('[role="tabpanel"]'));

    const activar = (indice: number, mover = true) => {
      pestanas.forEach((pestana, i) => {
        const activa = i === indice;
        pestana.setAttribute('aria-selected', String(activa));
        pestana.tabIndex = activa ? 0 : -1;
        paneles[i]?.toggleAttribute('hidden', !activa);
      });
      if (mover) pestanas[indice]?.focus();
      pestanas[indice]?.scrollIntoView({ block: 'nearest', inline: 'center', behavior: 'smooth' });
    };

    pestanas.forEach((pestana, i) => {
      pestana.addEventListener('click', () => activar(i, false));
      pestana.addEventListener('keydown', (evento) => {
        const salto = evento.key === 'ArrowRight' ? 1 : evento.key === 'ArrowLeft' ? -1 : 0;
        if (salto === 0) return;
        evento.preventDefault();
        activar((i + salto + pestanas.length) % pestanas.length);
      });
    });
  });
</script>
