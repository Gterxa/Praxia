---
import Seccion from './Seccion.astro';
import CabeceraSeccion from './CabeceraSeccion.astro';
import Pendiente from './Pendiente.astro';
import { MOSTRAR_PENDIENTES } from '../consts';
---

<Seccion id="quienes-somos" class="seccion-cosmoq" fondo="surface">
  <div class="tcard-envoltura relative">
    <div class="tcard-fondo" aria-hidden="true"></div>

    <div class="tcard tarjeta relative z-[1] flex flex-col gap-8 p-6 lg:flex-row lg:p-8">
      <div class="tcard__img flex flex-col gap-3 lg:flex-[0.5_0_0]">
        <div class="flex aspect-video items-center justify-center overflow-hidden rounded-tarjeta border border-linea bg-void/40">
          {
            MOSTRAR_PENDIENTES ? (
              <Pendiente que="video corto de presentación del equipo" />
            ) : (
              <span class="pequeno text-texto-3">Video del equipo, pronto</span>
            )
          }
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="flex aspect-4/3 items-center justify-center overflow-hidden rounded-tarjeta border border-linea bg-void/40">
            {
              MOSTRAR_PENDIENTES ? (
                <Pendiente que="foto de reunión con cliente" />
              ) : (
                <span class="pequeno text-texto-3">Foto pronto</span>
              )
            }
          </div>
          <div class="flex aspect-4/3 items-center justify-center overflow-hidden rounded-tarjeta border border-linea bg-void/40">
            {
              MOSTRAR_PENDIENTES ? (
                <Pendiente que="foto trabajando, pantalla real" />
              ) : (
                <span class="pequeno text-texto-3">Foto pronto</span>
              )
            }
          </div>
        </div>
      </div>

      <div class="tcard__body flex flex-col justify-center gap-6 lg:flex-[1_0_0]">
        <CabeceraSeccion etiqueta="Quiénes somos" icono="personas" apilada>
          <h2 slot="titulo" class="revelar" data-retraso="1">
            Un núcleo pequeño, especialistas según el proyecto
          </h2>
          <div slot="subtitulo" class="flex flex-col gap-4">
            <p class="lead text-texto-2 revelar" data-retraso="2">
              Hablas con quien construye. Nadie te vende algo que no vamos a poder sostener.
            </p>
            <p class="text-texto-2 revelar" data-retraso="3">
              Existimos para que la automatización con IA sea real y rentable para negocios sin
              área de tecnología.
            </p>
          </div>
        </CabeceraSeccion>
      </div>
    </div>
  </div>
</Seccion>

<style>
  /* Equivalente al .testi__gradient de cosmoq: rampa "atardecer" en
     radiales, borrosa y tenue, detrás de la tarjeta de vidrio — sin copiar
     ningún asset. */
  .tcard-fondo {
    position: absolute;
    inset: -3rem -2.5rem;
    z-index: 0;
    overflow: hidden;
    opacity: 0.22;
    pointer-events: none;
    filter: blur(48px);
    background:
      radial-gradient(circle at 12% 20%, var(--color-noche) 0%, transparent 55%),
      radial-gradient(circle at 88% 10%, var(--color-violeta) 0%, transparent 50%),
      radial-gradient(circle at 55% 95%, var(--color-coral) 0%, transparent 55%);
  }

  /* .tcard de cosmoq: tarjeta de vidrio — fondo blanco translúcido en capas +
     blur(10px), en vez del fondo sólido de .tarjeta. El borde ::after de
     .tarjeta se conserva tal cual (patrón pedido por la tarea). */
  .tcard {
    background: linear-gradient(180deg, rgb(255 255 255 / 0.07), rgb(255 255 255 / 0.03));
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }
</style>
