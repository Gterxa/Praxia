---
import Icon from './Icon.astro';
import { whatsappLink, MENSAJES_WHATSAPP } from '../consts';

interface Props {
  titulo?: string;
  texto?: string;
  mensajeWhatsApp?: string;
}

const {
  titulo = 'Conversemos 45 minutos.',
  texto = 'Nos cuentas qué te gustaría automatizar y salimos de ahí con una respuesta clara: qué se puede hacer y cómo lo haríamos.',
  mensajeWhatsApp = MENSAJES_WHATSAPP.cierre,
} = Astro.props;
---

<section class="seccion bg-tinta text-hueso">
  <div class="contenedor">
    <h2 class="max-w-2xl text-hueso">{titulo}</h2>
    <p class="lead mt-5 max-w-2xl !text-gris-200">{texto}</p>
    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
      <a href="/diagnostico" class="boton boton-claro">Agenda tu diagnóstico</a>
      <a
        href={whatsappLink(mensajeWhatsApp)}
        target="_blank"
        rel="noopener"
        class="boton boton-borde-claro"
      >
        <Icon nombre="whatsapp" tamano={20} />
        WhatsApp
      </a>
    </div>
  </div>
</section>
