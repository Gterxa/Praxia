---
interface Props {
  class?: string;
}
const { class: clase = '' } = Astro.props;
---

<span class={`inline-flex items-baseline gap-[0.15em] ${clase}`}>
  <span
    class="font-[family-name:var(--font-titulos)] text-[1.375rem] font-semibold tracking-tight text-texto"
    >Praxia</span
  >
  <span class="punto" aria-hidden="true"></span>
</span>

<style>
  /* El punto de la marca: una esfera con la rampa completa "atardecer",
     no un color plano. */
  .punto {
    display: block;
    height: 0.34rem;
    width: 0.34rem;
    border-radius: 999px;
    background: var(--degradado-punto);
  }
</style>
