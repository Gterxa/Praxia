---
/**
 * Marquee "Trusted by", copia literal (HTML + CSS + assets) del de
 * cosmoq-framer-website-20260911 — traído desde la rama qa-marquee-cosmoq
 * a pedido de Tony (sep 2026), en vez del marquee anterior armado sobre
 * LogosClientes/Marquee.astro con los logos reales de Praxia.
 *
 * OJO: los seis logos de public/cosmoq-demo/ son el asset original del
 * template de cosmoq (marcas genéricas de su banco de ejemplos), no
 * clientes reales de Praxia — ver nota en el mensaje de respuesta.
 *
 * Tamaño a 3x del original (150x48 → 450x144, gap y paso del keyframe
 * escalados igual) a pedido explícito.
 */
const ARCHIVOS = [
  'eTOvR4ZuGGQENAaE3zs5ZqZxtks.png',
  'QvWxQDGRcrTJWGZp7OsUlI4k6w0.png',
  'ZrGThO8Gp1y7Hoki1Dmhr0Flw6U.png',
  'dTohPdySQSHpfv4TUIdRVoRdHBw.png',
  'WzG2yfwdF7vdqrjvFu4j7tyJ3Gs.png',
  'FkPCvWLJEloyx0AnJETPfPfMx4.png',
];

// El original genera esto en cliente con JS (4 vueltas × 6 logos). Se
// replica en build para no meter un <script> nuevo; el resultado es idéntico.
const LOGOS = Array.from({ length: 4 }, () => ARCHIVOS).flat();
---

<div class="logos" aria-label="Trusted by">
  <div class="logos__track">
    <ul class="logos__list">
      {LOGOS.map((f, i) => (
        <li>
          <img src={`/cosmoq-demo/${f}`} alt={`Logo ${(i % ARCHIVOS.length) + 1}`} width="450" height="144" loading="lazy" />
        </li>
      ))}
    </ul>
  </div>
</div>

<style>
  .logos {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 48px;
    width: 100%;
    padding-block: 2rem;
  }
  .logos__track {
    display: flex;
    align-items: center;
    width: 100%;
    max-width: 100%;
    padding: 10px;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to right, transparent 0%, #000 20%, #000 80%, transparent 100%);
    mask-image: linear-gradient(to right, transparent 0%, #000 20%, #000 80%, transparent 100%);
  }
  .logos__list {
    display: flex;
    align-items: center;
    gap: 96px;
    width: max-content;
    padding: 15px 0;
    animation: cosmoq-marquee 32s linear infinite;
  }
  .logos__list li {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 450px;
    height: 144px;
    overflow: hidden;
  }
  .logos__list img {
    width: 450px;
    height: 144px;
    object-fit: cover;
    filter: grayscale(1);
  }
  @keyframes cosmoq-marquee {
    from { transform: translateX(0); }
    to { transform: translateX(calc(-6 * 546px)); }
  }
</style>
