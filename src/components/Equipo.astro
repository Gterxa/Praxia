---
/**
 * Sección de equipo: seis fotos en tres columnas escalonadas (patrón
 * "team-showcase") + lista de nombres/roles con hover cruzado foto↔fila.
 * Reemplaza a QuienesSomos.astro en el flujo de la home (mismo lugar,
 * después de Ejemplos y antes de FAQ).
 *
 * Nombres, roles y fotos son los reales. Fotos en src/assets/equipo/,
 * optimizadas acá con getImage (webp, 800px = 2x el tamaño mostrado de
 * 400px) y pasadas ya resueltas tanto a la isla React (EquipoShowcase)
 * como al <img> del marquee móvil, para no duplicar el pipeline.
 */
import { getImage } from 'astro:assets';
import Seccion from './Seccion.astro';
import CabeceraSeccion from './CabeceraSeccion.astro';
import EquipoShowcase from './ui/equipo-showcase.tsx';
import type { MiembroEquipo } from './ui/equipo-showcase.tsx';
import Marquee from './Marquee.astro';
import alvaro from '../assets/equipo/alvaro-sanchez.png';
import piero from '../assets/equipo/piero-pizarro.jpg';
import gabriel from '../assets/equipo/gabriel-curay.jpeg';
import cesar from '../assets/equipo/cesar-garcia.jpeg';
import valentina from '../assets/equipo/valentina-sarango.jpg';
import milene from '../assets/equipo/milene-garrido.jpg';

const FUENTES = [
  { id: '1', nombre: 'Álvaro Sánchez', rol: 'Founder, Soluciones e IA', src: alvaro, social: { linkedin: 'https://www.linkedin.com/in/aalvaroasanchez/' } },
  { id: '2', nombre: 'Piero Pizarro', rol: 'Co-founder, Automatización', src: piero, social: { linkedin: 'https://www.linkedin.com/in/piero-andr%C3%A9-pizarro-basile/' } },
  { id: '3', nombre: 'Gabriel Curay', rol: 'Co-founder, Arquitectura', src: gabriel, social: { linkedin: 'https://www.linkedin.com/in/gabriel-curay-b11973262/' } },
  { id: '4', nombre: 'César García', rol: 'Partner, Dirección técnica', src: cesar, social: { linkedin: 'https://www.linkedin.com/in/cesarandresd04/' } },
  { id: '5', nombre: 'Valentina Sarango', rol: 'Partner, Dirección creativa', src: valentina, social: { linkedin: 'https://www.linkedin.com/in/valentinasarango/' } },
  { id: '6', nombre: 'Milene Garrido', rol: 'Partner, Desarrollo', src: milene, social: { linkedin: 'https://www.linkedin.com/in/mile-garridop/' } },
] as const;

// 800px = 2x el ancho mostrado (400px): nítido en retina sin servir el
// original (hasta 2 MB en el caso de alvaro-sanchez.png).
const MIEMBROS: MiembroEquipo[] = await Promise.all(
  FUENTES.map(async (m) => ({
    id: m.id,
    nombre: m.nombre,
    rol: m.rol,
    imagen: (await getImage({ src: m.src, width: 800, format: 'webp' })).src,
    social: m.social,
  })),
);
---

<Seccion id="equipo" class="seccion-cosmoq" fondo="surface">
  <CabeceraSeccion etiqueta="El equipo" icono="personas" apilada>
    <h2 slot="titulo" class="revelar" style="--i:0">
      Un núcleo pequeño, especialistas según el proyecto
    </h2>
    <div slot="subtitulo" class="flex flex-col gap-4">
      <p class="lead text-texto-2 revelar" style="--i:1">
        Hablas con quien construye. Nadie te vende algo que no vamos a poder sostener.
      </p>
    </div>
  </CabeceraSeccion>

  <div class="mt-10 hidden lg:block">
    <EquipoShowcase miembros={MIEMBROS} client:visible />
  </div>

  <div class="mt-10 lg:hidden">
    <Marquee velocidad={55}>
      {
        MIEMBROS.map((miembro) => (
          <li class="w-52 flex-none sm:w-60">
            <figure class="tarjeta relative aspect-[4/5] w-full overflow-hidden p-0">
              <img
                src={miembro.imagen}
                alt={miembro.nombre}
                width={400}
                height={500}
                loading="lazy"
                decoding="async"
                class="h-full w-full object-cover grayscale"
              />
              <figcaption class="vidrio absolute inset-x-2 bottom-2 flex flex-col gap-1 rounded-praxia px-3.5 py-3">
                <div class="flex items-center gap-1.5">
                  <span
                    class="text-base font-semibold leading-none tracking-tight text-texto"
                    style={{ fontFamily: 'var(--font-titulos)' }}
                  >
                    {miembro.nombre}
                  </span>
                  {miembro.social?.linkedin && (
                    <a
                      href={miembro.social.linkedin}
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label={`LinkedIn de ${miembro.nombre}`}
                      class="flex-shrink-0 rounded p-0.5 text-texto-2 transition-colors duration-150 hover:text-texto"
                    >
                      <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" fill="#fff" viewBox="0 0 16 16">
                        <path d="M0 1.146C0 .513.526 0 1.175 0h13.65C15.474 0 16 .513 16 1.146v13.708c0 .633-.526 1.146-1.175 1.146H1.175C.526 16 0 15.487 0 14.854zm4.943 12.248V6.169H2.542v7.225zm-1.2-8.212c.837 0 1.358-.554 1.358-1.248-.015-.709-.52-1.248-1.342-1.248S2.4 3.226 2.4 3.934c0 .694.521 1.248 1.327 1.248zm4.908 8.212V9.359c0-.216.016-.432.08-.586.173-.431.568-.878 1.232-.878.869 0 1.216.662 1.216 1.634v3.865h2.401V9.25c0-2.22-1.184-3.252-2.764-3.252-1.274 0-1.845.7-2.165 1.193v.025h-.016l.016-.025V6.169h-2.4c.03.678 0 7.225 0 7.225z" />
                      </svg>
                    </a>
                  )}
                </div>
                <span class="text-[9px] font-medium uppercase tracking-[0.2em] text-texto/85">
                  {miembro.rol}
                </span>
              </figcaption>
            </figure>
          </li>
        ))
      }
    </Marquee>
  </div>
</Seccion>
