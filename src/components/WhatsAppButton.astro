---
import Icon from './Icon.astro';
import { waLink } from '../consts';

interface Props {
  /** El contexto que se prellena en el chat. Ver CONTEXTO en consts.ts. */
  contexto: string;
}
const { contexto } = Astro.props;
---

<a
  href={waLink(contexto)}
  target="_blank"
  rel="noopener"
  class="fixed right-4 bottom-4 z-40 inline-flex items-center gap-2 rounded-full border border-verde bg-verde px-4 py-3.5 font-semibold text-void transition-colors hover:bg-[color-mix(in_srgb,var(--color-verde)_82%,white)] md:right-6 md:bottom-6 md:px-4 md:py-3"
>
  <Icon nombre="whatsapp" tamano={22} />
  <span class="pequeno hidden sm:inline">Escríbenos</span>
  <span class="sr-only sm:hidden">Escríbenos por WhatsApp</span>
</a>
