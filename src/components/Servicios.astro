---
import Icon from './Icon.astro';
import Seccion from './Seccion.astro';
import CabeceraSeccion from './CabeceraSeccion.astro';
import { SERVICIOS } from '../servicios';
import { waLink, CONTEXTO } from '../consts';
---

<Seccion id="servicios" class="seccion-cosmoq">
  <CabeceraSeccion etiqueta="El paquete" icono="reportes">
    <h2 slot="titulo" class="revelar" data-retraso="1">Todo el lado técnico, en un solo lugar</h2>
    <p slot="subtitulo" class="lead text-texto-2 revelar" data-retraso="2">
      Tomas lo que necesitas. Lo dejamos funcionando junto.
    </p>
  </CabeceraSeccion>

  <div class="mt-10" data-servicios>
    <div class="mb-8 flex flex-wrap justify-center gap-2" role="tablist" aria-label="Servicios de Praxia">
      {
        SERVICIOS.map((s, i) => (
          <button
            type="button"
            role="tab"
            id={`servicio-tab-${s.id}`}
            aria-controls={`servicio-panel-${s.id}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
            class="pestana-pill"
          >
            {s.etiqueta}
          </button>
        ))
      }
    </div>

    {
      SERVICIOS.map((s, i) => (
        <div
          role="tabpanel"
          id={`servicio-panel-${s.id}`}
          aria-labelledby={`servicio-tab-${s.id}`}
          hidden={i !== 0}
          class="tarjeta panel-servicio p-6 md:p-10"
        >
          <div class="grid gap-8 md:grid-cols-[1.1fr_1fr] md:items-center md:gap-14">
            <div class="flex flex-col gap-5">
              <div>
                <h3 class="text-[1.375rem] font-semibold text-texto md:text-[1.625rem]">{s.titulo}</h3>
                <p class="mt-3 text-texto-2">{s.blurb}</p>
              </div>
              <ul class="flex flex-wrap gap-2">
                {s.chips.map((c) => (
                  <li class="chip-mono">{c}</li>
                ))}
              </ul>
              <a
                href={waLink(CONTEXTO.servicios(s.etiqueta))}
                target="_blank"
                rel="noopener"
                class="boton boton-primario w-fit"
              >
                Validar esto para mi negocio
                <Icon nombre="flecha" tamano={18} />
              </a>
            </div>

            <div class="rounded-praxia border border-linea bg-void/40 p-3 md:p-4">
              <table class="w-full border-collapse text-left">
                <caption class="mono px-3 pt-1 pb-3 text-left text-texto-3">Flujos típicos</caption>
                <tbody>
                  {s.flujos.map((f) => (
                    <tr class="border-t border-linea first:border-t-0">
                      <td class="px-3 py-3 text-[0.9375rem] text-texto">{f.nombre}</td>
                      <td class="px-3 py-3 text-right font-[family-name:var(--font-mono)] text-[0.8125rem] text-texto-3">
                        {f.plazo}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        </div>
      ))
    }
  </div>
</Seccion>

<style>
  /* Borde del panel `pcontent` de cosmoq: nunca --color-linea gris plano,
     siempre la línea tenue con tinte de --color-linea-viva (ver
     CabeceraSeccion .cabecera-linea, mismo valor). */
  .panel-servicio::after {
    border-color: rgb(84 124 255 / 0.16);
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-servicios]').forEach((grupo) => {
    const pestanas = Array.from(grupo.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const paneles = Array.from(grupo.querySelectorAll<HTMLElement>('[role="tabpanel"]'));

    const activar = (indice: number, mover = true) => {
      pestanas.forEach((pestana, i) => {
        const activa = i === indice;
        pestana.setAttribute('aria-selected', String(activa));
        pestana.tabIndex = activa ? 0 : -1;
        paneles[i]?.toggleAttribute('hidden', !activa);
      });
      if (mover) pestanas[indice]?.focus();
    };

    pestanas.forEach((pestana, i) => {
      pestana.addEventListener('click', () => activar(i, false));
      pestana.addEventListener('keydown', (evento) => {
        const salto = evento.key === 'ArrowRight' ? 1 : evento.key === 'ArrowLeft' ? -1 : 0;
        if (salto === 0) return;
        evento.preventDefault();
        activar((i + salto + pestanas.length) % pestanas.length);
      });
    });
  });
</script>
