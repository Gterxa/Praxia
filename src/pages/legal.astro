---
import Layout from '../layouts/Layout.astro';
import Seccion from '../components/Seccion.astro';
import Pendiente from '../components/Pendiente.astro';
import { SITE, CONTACTO, MOSTRAR_PENDIENTES } from '../consts';
---

<Layout
  titulo="Términos legales"
  descripcion="Términos de uso del sitio de Praxia y condiciones generales de los servicios."
  noIndex={true}
>
  <Seccion>
    <div class="medida">
      <h1>Términos legales</h1>
      {
        MOSTRAR_PENDIENTES && (
          <p class="pequeno mt-4 text-gris-600">
            Última actualización: <Pendiente que="fecha" />
          </p>
        )
      }

      <div class="mt-10 space-y-8">
        <div>
          <h2 class="text-[1.25rem] md:text-[1.5rem]">Quiénes somos</h2>
          {
            MOSTRAR_PENDIENTES ? (
              <p class="mt-3 text-gris-600">
                {SITE.nombre}, <Pendiente que="razón social y RUC" />, con domicilio en{' '}
                <Pendiente que="dirección fiscal" />. Puedes escribirnos a {CONTACTO.email}.
              </p>
            ) : (
              <p class="mt-3 text-gris-600">
                {SITE.nombre}, agencia de automatización con inteligencia artificial que opera en
                el Perú. Puedes escribirnos a {CONTACTO.email}.
              </p>
            )
          }
        </div>

        <div>
          <h2 class="text-[1.25rem] md:text-[1.5rem]">Uso de este sitio</h2>
          <p class="mt-3 text-gris-600">
            El contenido de este sitio es informativo. Los ejemplos y las conversaciones que se
            muestran son ilustrativos: no son clientes atendidos ni promesas de resultado.
            Las condiciones de cada trabajo se definen por escrito antes de empezar.
          </p>
        </div>

        <div>
          <h2 class="text-[1.25rem] md:text-[1.5rem]">Contratación de servicios</h2>
          <p class="mt-3 text-gris-600">
            Las condiciones de cada servicio, incluyendo alcance, plazos, formas de pago y
            propiedad de lo construido, se establecen en la propuesta que firmamos contigo. Nada de
            lo publicado en este sitio reemplaza ese documento.
          </p>
          {
            MOSTRAR_PENDIENTES && (
              <p class="mt-3 text-gris-600">
                <Pendiente que="condiciones generales revisadas por un abogado" />
              </p>
            )
          }
        </div>

        <div>
          <h2 class="text-[1.25rem] md:text-[1.5rem]">Propiedad intelectual</h2>
          <p class="mt-3 text-gris-600">
            La marca, los textos y el diseño de este sitio son de {SITE.nombre}. El contenido y los
            datos que nos entregas para una implementación siguen siendo tuyos.
          </p>
        </div>

        <div>
          <h2 class="text-[1.25rem] md:text-[1.5rem]">Ley aplicable</h2>
          <p class="mt-3 text-gris-600">
            Estos términos se rigen por las leyes de la República del Perú.
          </p>
        </div>
      </div>
    </div>
  </Seccion>
</Layout>
