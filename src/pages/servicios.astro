---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Servicios from '../components/Servicios.astro';
import { CONTEXTO } from '../consts';
---

<Layout
  titulo="Servicios de automatización con IA, diseño web y SEO"
  descripcion="Automatización con IA, diseño web, SEO y seguridad para negocios en Perú. Un solo responsable y 2 a 4 semanas. El precio se da en la llamada de validación."
  contextoWhatsApp={CONTEXTO.servicios('automatización con IA')}
  imagen="/og/servicios.jpg"
>
  <Hero
    antetitulo="Servicios"
    titulo="Automatización con IA, diseño web y seguridad. Un solo responsable."
    subtitulo="Automatizamos con IA las tareas repetitivas, diseñamos tu web con SEO y la mantenemos segura. Un solo responsable para los tres, sin coordinar cuatro proveedores."
    compacto
  />
  <Servicios />
</Layout>
