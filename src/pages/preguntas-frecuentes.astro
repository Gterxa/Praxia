---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Seccion from '../components/Seccion.astro';
import FAQTabs from '../components/ui/faq-tabs.tsx';
import FichaHero from '../components/FichaHero.astro';
import CTABand from '../components/CTABand.astro';
import { CONTEXTO } from '../consts';
import { PREGUNTAS_FRECUENTES, CATEGORIAS_FAQ, agruparPorCategoria } from '../faq';

const faqData = agruparPorCategoria(PREGUNTAS_FRECUENTES);
---

<Layout
  titulo="Preguntas frecuentes"
  descripcion="Cuánto demora una automatización, cómo definimos el presupuesto, qué pasa si tu idea no es viable y qué necesitas para empezar."
  contextoWhatsApp={CONTEXTO.preguntas}
>
  <Hero
    antetitulo="Preguntas frecuentes"
    titulo="Lo que todos preguntan antes de escribirnos."
    subtitulo="Si tu duda no está acá, escríbenos y te la respondemos."
    contextoWhatsApp={CONTEXTO.preguntas}
    compacto
  >
    <FichaHero slot="aside" contextoWhatsApp={CONTEXTO.preguntas} />
  </Hero>

  <Seccion fondo="surface">
    <FAQTabs categorias={CATEGORIAS_FAQ} faqData={faqData} client:visible />
  </Seccion>

  <CTABand contextoWhatsApp={CONTEXTO.preguntas} />
</Layout>
