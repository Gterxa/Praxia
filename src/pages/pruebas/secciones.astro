---
/**
 * Banco de pruebas de las secciones "estilo cosmoq" (sep 2026): la home
 * completa, con un toggle en vivo entre las dos variantes tipográficas de
 * los titulares. No se indexa y no está enlazada desde ninguna parte del
 * sitio — es para decidir, comparar con capturas, no una página pública.
 *
 * `?tipo=a` / `?tipo=b` en la URL fijan la variante al cargar (útil para
 * capturar cada una por separado); el botón cambia en vivo sin recargar.
 * El sitio es estático (sin adapter de servidor), así que la variante
 * inicial que renderiza el HTML es siempre 'a' — el query string solo lo
 * lee el script del cliente, igual que el resto de bancos de prueba de
 * este proyecto (ver pruebas/hero.astro).
 */
import Layout from '../../layouts/Layout.astro';
import HeroHome from '../../components/HeroHome.astro';
import LogosMarqueeCosmoq from '../../components/LogosMarqueeCosmoq.astro';
import SeccionesHome from '../../components/SeccionesHome.astro';
import { CONTEXTO } from '../../consts';
---

<Layout
  titulo="Banco de pruebas — secciones estilo cosmoq"
  descripcion="Herramienta interna para comparar variantes tipográficas del rediseño de secciones."
  contextoWhatsApp={CONTEXTO.home}
  noIndex={true}
  tipografia="a"
>
  <HeroHome />
  <LogosMarqueeCosmoq />
  <SeccionesHome />

  <div class="banco-tipo" id="banco-tipo">
    <div class="banco-tipo__spec mono" id="banco-tipo-spec">
      <p data-spec="a">VARIANTE A · Títulos: Space Grotesk 500 · 56px/1.2 · -0.02em · Cuerpo: Manrope 400 18px/1.65</p>
      <p data-spec="b">VARIANTE B · Títulos: Manrope 400 · 56px/1.2 · -0.02em · Cuerpo: Manrope 400 18px/1.65</p>
    </div>
    <div class="banco-tipo__botones">
      <button type="button" class="banco-tipo__boton" data-valor="a" aria-pressed="true">
        A · Space Grotesk
      </button>
      <button type="button" class="banco-tipo__boton" data-valor="b" aria-pressed="false">
        B · Manrope
      </button>
    </div>
  </div>
</Layout>

<style>
  .banco-tipo {
    position: fixed;
    left: 50%;
    bottom: 1rem;
    transform: translateX(-50%);
    z-index: 60;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.625rem;
    max-width: calc(100vw - 1.5rem);
    padding: 0.875rem 1.25rem;
    border-radius: var(--radius-tarjeta);
    background: linear-gradient(180deg, rgb(255 255 255 / 0.08), rgb(255 255 255 / 0.03));
    border: 1px solid rgb(255 255 255 / 0.12);
    backdrop-filter: blur(18px) saturate(1.3);
    -webkit-backdrop-filter: blur(18px) saturate(1.3);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.14),
      0 18px 50px rgb(0 0 0 / 0.45);
  }

  .banco-tipo__spec {
    color: var(--color-texto-3);
    text-align: center;
  }

  .banco-tipo__spec p {
    display: none;
  }

  html[data-tipo='a'] .banco-tipo__spec p[data-spec='a'],
  html[data-tipo='b'] .banco-tipo__spec p[data-spec='b'] {
    display: block;
  }

  .banco-tipo__botones {
    display: flex;
    gap: 0.5rem;
  }

  .banco-tipo__boton {
    padding: 0.5rem 1rem;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-linea);
    background: transparent;
    color: var(--color-texto-2);
    font-family: var(--font-titulos);
    font-size: 0.875rem;
    font-weight: 500;
    cursor: pointer;
    transition:
      color 200ms var(--ease-suave),
      background-color 200ms var(--ease-suave),
      border-color 200ms var(--ease-suave);
  }

  .banco-tipo__boton:hover {
    color: var(--color-texto);
    border-color: var(--color-linea-viva);
  }

  .banco-tipo__boton:focus-visible {
    outline: 2px solid var(--color-brasa);
    outline-offset: 2px;
  }

  .banco-tipo__boton:active {
    transform: scale(0.96);
  }

  .banco-tipo__boton[aria-pressed='true'] {
    background: var(--color-brasa);
    border-color: var(--color-brasa);
    color: var(--color-void);
  }

  @media (max-width: 30rem) {
    .banco-tipo__spec {
      font-size: 0.6875rem;
    }
  }
</style>

<script>
  const html = document.documentElement;
  const barra = document.getElementById('banco-tipo');

  function marcar(valor: string) {
    barra?.querySelectorAll<HTMLButtonElement>('.banco-tipo__boton').forEach((b) => {
      b.setAttribute('aria-pressed', String(b.dataset['valor'] === valor));
    });
  }

  function aplicar(valor: string, sincronizarUrl = true) {
    if (valor !== 'a' && valor !== 'b') return;
    html.dataset['tipo'] = valor;
    marcar(valor);
    if (sincronizarUrl) {
      const url = new URL(location.href);
      url.searchParams.set('tipo', valor);
      history.replaceState(null, '', url);
    }
  }

  // Variante inicial: la del query string, si trae una válida.
  const inicial = new URLSearchParams(location.search).get('tipo');
  if (inicial === 'a' || inicial === 'b') aplicar(inicial, false);

  barra?.addEventListener('click', (evento) => {
    const boton = (evento.target as HTMLElement).closest<HTMLButtonElement>('.banco-tipo__boton');
    const valor = boton?.dataset['valor'];
    if (valor) aplicar(valor);
  });
</script>
