---
import Layout from '../layouts/Layout.astro';
import SectionLabel from '../components/SectionLabel.astro';
import Seccion from '../components/Seccion.astro';
import Icon from '../components/Icon.astro';
import FormularioValidar from '../components/FormularioValidar.astro';
import { CONTEXTO, waLink } from '../consts';

const PROMESAS = [
  'Precio y plazo estimados',
  'Viabilidad honesta: sí, no o aún no',
  'Diagrama del flujo que propondríamos',
  'Qué automatizar primero',
] as const;
---

<Layout
  titulo="Validar mi idea"
  descripcion="Validación de tu idea en 15 minutos, sin costo. Un formulario corto y te respondemos el mismo día."
  contextoWhatsApp={CONTEXTO.validar}
>
  <Seccion>
    <div class="grid gap-12 lg:grid-cols-2 lg:gap-16">
      <div class="order-1 lg:order-none">
        <SectionLabel texto="Validemos tu idea" />
        <h1 class="mt-4">Cuéntanos qué quieres automatizar.</h1>
        <p class="lead mt-6">
          Un formulario corto. Te respondemos el mismo día con una hora para los 15 minutos.
        </p>

        <ul class="mt-8 space-y-3">
          {
            PROMESAS.map((p) => (
              <li class="flex items-start gap-2.5 text-texto">
                <span class="mt-0.5 flex-none text-brasa">
                  <Icon nombre="flecha" tamano={18} />
                </span>
                {p}
              </li>
            ))
          }
        </ul>

        <div class="mt-12 hidden border-t border-linea pt-8 lg:block">
          <p class="text-texto-2">
            ¿Prefieres no llenar formularios? Escríbenos directo. Es el mismo camino y suele ser
            más rápido.
          </p>
          <a
            href={waLink(CONTEXTO.validar)}
            target="_blank"
            rel="noopener"
            class="boton boton-primario mt-5"
          >
            <Icon nombre="whatsapp" tamano={20} />
            Escríbenos por WhatsApp
          </a>
        </div>
      </div>

      <div class="order-2 lg:order-none">
        <div class="tarjeta">
          <h2 class="text-[1.25rem] md:text-[1.5rem]">Cuéntanos en un formulario</h2>
          <div class="mt-6">
            <FormularioValidar idPrefix="pagina" />
          </div>
        </div>
      </div>

      <div class="order-3 border-t border-linea pt-8 lg:hidden">
        <p class="text-texto-2">
          ¿Prefieres no llenar formularios? Escríbenos directo. Es el mismo camino y suele ser más
          rápido.
        </p>
        <a
          href={waLink(CONTEXTO.validar)}
          target="_blank"
          rel="noopener"
          class="boton boton-primario mt-5"
        >
          <Icon nombre="whatsapp" tamano={20} />
          Escríbenos por WhatsApp
        </a>
      </div>
    </div>
  </Seccion>
</Layout>
