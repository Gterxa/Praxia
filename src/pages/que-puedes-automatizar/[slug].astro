---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/Hero.astro';
import Seccion from '../../components/Seccion.astro';
import ListaCheck from '../../components/ListaCheck.astro';
import ChatMockup from '../../components/ChatMockup.astro';
import ExampleBlock from '../../components/ExampleBlock.astro';
import CapabilityCard from '../../components/CapabilityCard.astro';
import CTABand from '../../components/CTABand.astro';
import { MENSAJES_WHATSAPP } from '../../consts';

export const getStaticPaths = (async () => {
  const capacidades = await getCollection('capacidades');
  return capacidades.map((capacidad) => ({
    params: { slug: capacidad.id },
    props: { capacidad },
  }));
}) satisfies GetStaticPaths;

type Props = { capacidad: Awaited<ReturnType<typeof getCollection<'capacidades'>>>[number] };

const { capacidad } = Astro.props;
const d = capacidad.data;

const otras = (await getCollection('capacidades'))
  .filter((c) => c.id !== capacidad.id)
  .sort((a, b) => a.data.orden - b.data.orden)
  .slice(0, 3);

const mensaje = MENSAJES_WHATSAPP.capacidad(d.nombreCorto);
---

<Layout titulo={d.seoTitulo} descripcion={d.seoDescripcion} mensajeWhatsApp={mensaje}>
  <Hero
    antetitulo={d.nombreCorto}
    titulo={d.titulo}
    subtitulo={d.subtitulo}
    mensajeWhatsApp={mensaje}
  />

  <!-- Qué hace -->
  <Seccion fondo="blanco">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,20rem)_1fr] lg:gap-16">
      <h2 class="text-[1.625rem] md:text-[2rem]">Qué hace</h2>
      <ListaCheck items={d.queHace} class="max-w-2xl text-[1.0625rem] md:text-[1.125rem]" />
    </div>
  </Seccion>

  <!-- Cómo se ve: la conversación -->
  <Seccion>
    <div class="grid items-start gap-10 lg:grid-cols-[minmax(0,26rem)_1fr] lg:gap-16">
      <div class="lg:pt-2">
        <h2 class="text-[1.625rem] md:text-[2rem]">Cómo se ve</h2>
        <p class="mt-4 max-w-md text-gris-600">
          Así se ve por dentro, en el mismo lugar donde tus clientes ya te escriben.
        </p>
      </div>
      <div class="flex lg:justify-center">
        <ChatMockup negocio={d.conversacion.negocio} mensajes={d.conversacion.mensajes} />
      </div>
    </div>
  </Seccion>

  <!-- En tu rubro -->
  <Seccion fondo="blanco">
    <h2 class="text-[1.625rem] md:text-[2rem]">En tu rubro</h2>
    <p class="mt-3 max-w-xl text-gris-600">
      Lo que esta automatización resuelve en negocios distintos.
    </p>
    <div class="mt-8">
      <ExampleBlock ejemplos={d.ejemplosPorRubro} />
    </div>
  </Seccion>

  <!-- Qué necesitas para empezar -->
  <Seccion>
    <div class="grid gap-8 lg:grid-cols-[minmax(0,20rem)_1fr] lg:gap-16">
      <div>
        <h2 class="text-[1.625rem] md:text-[2rem]">Qué necesitas para empezar</h2>
        <p class="pequeno mt-3 text-gris-600">
          Poco. Casi siempre ya lo tienes.
        </p>
      </div>
      <div class="max-w-2xl">
        <ListaCheck items={d.queNecesitas} />
        <p class="pequeno mt-8 text-gris-600">
          ¿Dudas sobre tus datos? Lee <a href="/seguridad" class="enlace">cómo los cuidamos</a>.
        </p>
      </div>
    </div>
  </Seccion>

  <!--
    Puente hacia la capa mayor. Solo aparece en documentos-y-archivo: es la
    capacidad que naturalmente desemboca en un espacio de trabajo documental.
  -->
  {
    capacidad.id === 'documentos-y-archivo' && (
      <Seccion fondo="tinta">
        <div class="medida">
          <p class="antetitulo !text-arcilla-300">Cuando el volumen crece</p>
          <h2 class="mt-3 text-hueso">¿Y si no son cien documentos, sino diez mil?</h2>
          <p class="lead mt-5 !text-gris-200">
            Ordenar lo que entra resuelve el día a día. Cuando el problema es un archivo histórico
            enorme que nadie puede consultar de forma rápida y confiable, hace falta algo más
            grande.
          </p>
          <a href="/soluciones-mayores" class="boton boton-claro mt-8">
            Ver de qué se trata
          </a>
        </div>
      </Seccion>
    )
  }

  <!-- Otras capacidades -->
  <Seccion fondo="blanco">
    <h2 class="text-[1.375rem] md:text-[1.75rem]">También puedes automatizar</h2>
    <div class="mt-8 grid gap-4 md:grid-cols-3">
      {
        otras.map((c) => (
          <CapabilityCard
            href={`/que-puedes-automatizar/${c.id}`}
            titulo={c.data.nombreCorto}
            resumen={c.data.resumen}
            icono={c.data.icono}
          />
        ))
      }
    </div>
  </Seccion>

  <CTABand mensajeWhatsApp={mensaje} />
</Layout>
