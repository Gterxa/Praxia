---
import type { GetStaticPaths } from 'astro';
import { getCapacidades } from '../../capacidades';
import Layout from '../../layouts/Layout.astro';
import SectionLabel from '../../components/SectionLabel.astro';
import Hero from '../../components/Hero.astro';
import Seccion from '../../components/Seccion.astro';
import ListaCheck from '../../components/ListaCheck.astro';
import ChatMockup from '../../components/ChatMockup.astro';
import ExampleBlock from '../../components/ExampleBlock.astro';
import CapabilityCard from '../../components/CapabilityCard.astro';
import CTABand from '../../components/CTABand.astro';
import CTAInline from '../../components/CTAInline.astro';
import Widget from '../../components/Widget.astro';
import { CONTEXTO, CHIPS_CONFIANZA } from '../../consts';

const widgets = {
  conversacion: 'chat',
  calendario: 'agenda',
  personas: 'clientes',
  documentos: 'documentos',
  reportes: 'reportes',
  contenido: 'contenido',
} as const;

export const getStaticPaths = (async () => {
  const capacidades = await getCapacidades();
  return capacidades.map((capacidad) => ({
    params: { slug: capacidad.id },
    props: { capacidad },
  }));
}) satisfies GetStaticPaths;

type Props = { capacidad: Awaited<ReturnType<typeof getCapacidades>>[number] };

const { capacidad } = Astro.props;
const d = capacidad.data;

const otras = (await getCapacidades()).filter((c) => c.id !== capacidad.id).slice(0, 3);

const mensaje = CONTEXTO.capacidad(d.nombreCorto);
---

<Layout titulo={d.seoTitulo} descripcion={d.seoDescripcion} contextoWhatsApp={mensaje}>
  <Hero
    antetitulo={d.nombreCorto}
    titulo={d.titulo}
    subtitulo={d.subtitulo}
    chips={CHIPS_CONFIANZA}
    contextoWhatsApp={mensaje}
  >
    <figure slot="visual" class="w-full max-w-sm rounded-praxia border border-linea bg-surface p-5 lg:w-[24rem]">
      <figcaption class="mono mb-4 text-texto-3">Así se ve por dentro</figcaption>
      <Widget tipo={widgets[d.icono]} class="!h-48 !gap-3 !p-5 !text-[0.875rem]" />
    </figure>
  </Hero>

  <!-- Qué hace -->
  <Seccion fondo="surface">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,20rem)_1fr] lg:gap-16">
      <div>
        <SectionLabel numero="01" texto="Qué hace" />
        <h2 class="mt-4 text-[1.625rem] md:text-[2rem]">Qué hace</h2>
      </div>
      <ListaCheck items={d.queHace} class="max-w-2xl text-[1.0625rem] md:text-[1.125rem]" />
    </div>
  </Seccion>

  <!-- Cómo se ve: la conversación -->
  <Seccion>
    <div class="grid items-start gap-10 lg:grid-cols-[minmax(0,26rem)_1fr] lg:gap-16">
      <div class="lg:pt-2">
        <SectionLabel numero="02" texto="Cómo se ve" />
        <h2 class="mt-4 text-[1.625rem] md:text-[2rem]">Cómo se ve</h2>
        <p class="mt-4 max-w-md text-texto-2">
          Así se ve por dentro, en el mismo lugar donde tus clientes ya te escriben.
        </p>
      </div>
      <div class="flex lg:justify-center">
        <ChatMockup negocio={d.conversacion.negocio} mensajes={d.conversacion.mensajes} />
      </div>
    </div>
  </Seccion>

  <CTAInline contextoWhatsApp={mensaje} />

  <!-- Dónde se nota -->
  <Seccion fondo="surface">
    <SectionLabel numero="03" texto="Dónde se nota" />
    <h2 class="mt-4 text-[1.625rem] md:text-[2rem]">Dónde se nota</h2>
    <p class="mt-3 max-w-xl text-texto-2">
      Situaciones concretas del día a día. Pasan en negocios muy distintos entre sí.
    </p>
    <div class="mt-8">
      <ExampleBlock ejemplos={d.ejemplos} />
    </div>
  </Seccion>

  <!-- Qué necesitas para empezar -->
  <Seccion>
    <div class="grid gap-8 lg:grid-cols-[minmax(0,20rem)_1fr] lg:gap-16">
      <div>
        <SectionLabel numero="04" texto="Qué necesitas" />
        <h2 class="mt-4 text-[1.625rem] md:text-[2rem]">Qué necesitas para empezar</h2>
        <p class="pequeno mt-3 text-texto-2">
          Poco. Casi siempre ya lo tienes.
        </p>
      </div>
      <div class="max-w-2xl">
        <ListaCheck items={d.queNecesitas} />
        <p class="pequeno mt-8 text-texto-2">
          ¿Dudas sobre tus datos? Lee <a href="/seguridad" class="enlace">cómo los cuidamos</a>.
        </p>
      </div>
    </div>
  </Seccion>

  <!--
    Puente hacia la capa mayor. Solo aparece en documentos-y-archivo: es la
    capacidad que naturalmente desemboca en un espacio de trabajo documental.
  -->
  {
    capacidad.id === 'documentos-y-archivo' && (
      <Seccion fondo="surface">
        <div class="medida">
          <SectionLabel texto="Cuando el volumen crece" />
          <h2 class="mt-4 text-texto">¿Y si no son cien documentos, sino diez mil?</h2>
          <p class="lead mt-5 !text-texto-2">
            Ordenar lo que entra resuelve el día a día. Cuando el problema es un archivo histórico
            enorme que nadie puede consultar de forma rápida y confiable, hace falta algo más
            grande.
          </p>
          <a href="/soluciones-mayores" class="boton boton-primario mt-8">
            Ver de qué se trata
          </a>
        </div>
      </Seccion>
    )
  }

  <!-- Otras capacidades -->
  <Seccion fondo="surface">
    <SectionLabel numero="05" texto="Seguir explorando" />
    <h2 class="mt-4 text-[1.375rem] md:text-[1.75rem]">También puedes automatizar</h2>
    <div class="mt-8 grid gap-4 md:grid-cols-3">
      {
        otras.map((c) => (
          <CapabilityCard
            href={`/que-puedes-automatizar/${c.id}`}
            titulo={c.data.nombreCorto}
            resumen={c.data.resumen}
            icono={c.data.icono}
          />
        ))
      }
    </div>
  </Seccion>

  <CTABand contextoWhatsApp={mensaje} />
</Layout>
