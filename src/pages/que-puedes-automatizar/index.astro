---
import { getCapacidades } from '../../capacidades';
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/Hero.astro';
import Seccion from '../../components/Seccion.astro';
import CapabilityCard from '../../components/CapabilityCard.astro';
import CTAInline from '../../components/CTAInline.astro';
import Herramientas from '../../components/Herramientas.astro';
import CTABand from '../../components/CTABand.astro';
import { CONTEXTO, CHIPS_CONFIANZA } from '../../consts';
import capacidadesImg from '../../assets/img/capacidades.png';

const capacidades = await getCapacidades();
---

<Layout
  titulo="Qué puedes automatizar en tu negocio"
  descripcion="Responder clientes, agendar citas, hacer seguimiento, clasificar documentos, sacar reportes y publicar. Seis cosas que la IA sí puede hacer hoy por tu negocio."
  contextoWhatsApp={CONTEXTO.hub}
>
  <Hero
    antetitulo="Qué puedes automatizar"
    titulo="Esto es lo que la IA puede hacer por tu negocio hoy."
    subtitulo="Estas son las seis cosas que mejor funcionan hoy. Sirven para cualquier negocio que atienda gente, agende, cobre o archive."
    chips={CHIPS_CONFIANZA}
    contextoWhatsApp={CONTEXTO.hub}
    imagen={capacidadesImg}
    imagenAlt="Seis nodos conectados entre sí, uno por cada capacidad"
    imagenPrioritaria
  />

  <Seccion fondo="surface">
    <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-4">
      {
        capacidades.map((c, i) => (
          <CapabilityCard
            href={`/que-puedes-automatizar/${c.id}`}
            titulo={c.data.nombreCorto}
            resumen={c.data.resumen}
            icono={c.data.icono}
            nivel={2}
            destacada={c.id === 'documentos-y-archivo'}
            ancha={i === 0 || i === 3}
          />
        ))
      }
    </div>
  </Seccion>

  <CTAInline
    texto="¿No ves lo tuyo en la lista? Cuéntanoslo en el diagnóstico."
    contextoWhatsApp={CONTEXTO.hub}
  />

  <Herramientas />

  <CTABand contextoWhatsApp={CONTEXTO.hub} />
</Layout>
