---
import { Font } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { SITE, CONTACTO } from '../consts';
import '../styles/global.css';

interface Props {
  titulo: string;
  descripcion: string;
  /** Mensaje prellenado del botón flotante de WhatsApp. */
  mensajeWhatsApp?: string;
  /** Deja fuera de los buscadores páginas que no queremos indexar. */
  noIndex?: boolean;
}

const {
  titulo,
  descripcion,
  mensajeWhatsApp = 'Hola Praxia, quiero hacer una consulta.',
  noIndex = false,
} = Astro.props;

const tituloCompleto = titulo.includes(SITE.nombre)
  ? titulo
  : `${titulo} | ${SITE.nombre}`;

const canonical = new URL(Astro.url.pathname.replace(/\/$/, '') || '/', Astro.site);
const imagenOG = new URL('/og-praxia.png', Astro.site);

const datosEstructurados = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: SITE.nombre,
  description: SITE.descripcion,
  url: SITE.url,
  slogan: SITE.tagline,
  email: CONTACTO.email,
  telephone: `+${CONTACTO.whatsapp}`,
  image: imagenOG.toString(),
  address: {
    '@type': 'PostalAddress',
    addressCountry: SITE.pais,
  },
  areaServed: {
    '@type': 'Country',
    name: 'Perú',
  },
  knowsLanguage: 'es-PE',
  serviceType: [
    'Automatización de procesos con inteligencia artificial',
    'Automatización de atención por WhatsApp',
    'Automatización de citas y recordatorios',
  ],
};
---

<!doctype html>
<html lang="es-PE">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonical} />
    <meta name="generator" content={Astro.generator} />

    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />
    {noIndex && <meta name="robots" content="noindex, follow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.nombre} />
    <meta property="og:locale" content="es_PE" />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imagenOG} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${SITE.nombre} — ${SITE.tagline}`} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={tituloCompleto} />
    <meta name="twitter:description" content={descripcion} />
    <meta name="twitter:image" content={imagenOG} />

    <meta name="theme-color" content="#FAF8F5" />

    <Font cssVariable="--font-titulos" preload />
    <Font cssVariable="--font-cuerpo" preload />

    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(datosEstructurados)}
    />
  </head>

  <body>
    <a class="skip-link" href="#contenido">Ir al contenido</a>
    <Header />
    <main id="contenido">
      <slot />
    </main>
    <Footer />
    <WhatsAppButton mensaje={mensajeWhatsApp} />
  </body>
</html>
