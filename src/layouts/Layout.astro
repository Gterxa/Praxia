---
import { Font } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import FondoOrbes from '../components/FondoOrbes.astro';
import { SITE, EMAIL, WHATSAPP, CONTEXTO } from '../consts';
import '../styles/global.css';
import { ruta, sinBase } from '../rutas';

interface Props {
  titulo: string;
  descripcion: string;
  /** Mensaje prellenado del botón flotante de WhatsApp. */
  contextoWhatsApp?: string;
  /** Deja fuera de los buscadores páginas que no queremos indexar. */
  noIndex?: boolean;
  /**
   * Banco de pruebas (sep 2026): variante tipográfica de los titulares,
   * exploración del sistema visual de cosmoq. 'a' = Space Grotesk 500 (marca
   * actual). 'b' = Manrope 400 (misma familia que el cuerpo, jugada literal
   * de cosmoq). Se emite como data-tipo en <html>; ver global.css.
   * Solo la usa /pruebas/secciones — el resto del sitio no la toca.
   */
  tipografia?: 'a' | 'b';
}

const {
  titulo,
  descripcion,
  contextoWhatsApp = CONTEXTO.flotante,
  noIndex = false,
  tipografia = 'a',
} = Astro.props;

const tituloCompleto = titulo.includes(SITE.nombre)
  ? titulo
  : `${titulo} | ${SITE.nombre}`;

// `sinBase` quita el prefijo de dev: la canonical siempre es la URL de producción.
const canonical = new URL(sinBase(Astro.url.pathname), Astro.site);
const imagenOG = new URL('/og-praxia.png', Astro.site);

/**
 * Organization + LocalBusiness, con `areaServed: "PE"` y sin ciudad.
 * Praxia opera de forma remota: segmentar por ciudad no aporta y compite en
 * keywords carísimas.
 */
const datosEstructurados = {
  '@context': 'https://schema.org',
  '@type': ['Organization', 'LocalBusiness'],
  '@id': `${SITE.url}/#praxia`,
  name: SITE.nombre,
  description: SITE.descripcion,
  url: SITE.url,
  slogan: SITE.tagline,
  email: EMAIL,
  telephone: `+${WHATSAPP}`,
  image: imagenOG.toString(),
  logo: imagenOG.toString(),
  areaServed: SITE.pais,
  knowsLanguage: 'es-PE',
  makesOffer: [
    'Automatización con IA: atención, citas, seguimiento, documentos y reportes',
    'Web, SEO y presencia local',
    'Seguridad y mantenimiento',
  ].map((nombre) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name: nombre } })),
};
---

<!doctype html>
<html lang="es-PE" data-tipo={tipografia}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href={ruta('/favicon.svg')} type="image/svg+xml" />
    <link rel="canonical" href={canonical} />
    <meta name="generator" content={Astro.generator} />

    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />
    {noIndex && <meta name="robots" content="noindex, follow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.nombre} />
    <meta property="og:locale" content="es_PE" />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imagenOG} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${SITE.nombre}: ${SITE.tagline}`} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={tituloCompleto} />
    <meta name="twitter:description" content={descripcion} />
    <meta name="twitter:image" content={imagenOG} />

    <meta name="theme-color" content="#000000" />

    <Font cssVariable="--font-titulos" preload />
    <Font cssVariable="--font-cuerpo" preload />
    {/* IBM Plex Mono estaba declarada en astro.config.mjs pero nunca se
        emitia acá, asi que var(--font-mono) no existia y todo lo que la usa
        (.mono, kickers, chips) caia al fallback del sistema. Sin preload: no
        entra en el primer render, a diferencia de titulos y cuerpo. */}
    <Font cssVariable="--font-mono" />
    <Font cssVariable="--font-crono" />

    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(datosEstructurados)}
    />

    {/*
      Blur de fondo para Safari e iOS 15.4–17.x, que sólo entienden
      `-webkit-backdrop-filter`. Desde iOS 18 ya no hace falta.

      Por qué vive acá suelto y no junto a cada regla: TODO el CSS del proyecto
      (global.css, los .css de componentes y las utilities) lo compila Tailwind
      v4 con targets hardcodeados en @tailwindcss/node (`safari: 16<<16|1024`,
      o sea 16.4). Con ese piso decide que no hace falta prefijar, ignora el
      `browserslist` del proyecto —y no se puede configurar—, y además borra
      cualquier `-webkit-backdrop-filter` que uno escriba al lado de la
      propiedad estándar, en cualquiera de los dos órdenes (comprobado con
      `vite.css.transformer` + `lightningcss.targets`: no cambia nada, el CSS
      nunca pasa por el pipeline de Vite). Este <style> no pasa por Tailwind,
      así que sobrevive; Astro le calcula su hash para la CSP.

      Sólo declara la variante prefijada: la estándar ya la emite Tailwind, y
      duplicarla sin prefijo rompería Firefox al colapsar la regla.

      Los valores tienen que coincidir con los de global.css y los .css de
      componentes. Al tocar un blur allá, actualizarlo también acá.
    */}
    <style is:global>
      .vidrio,
      .bento-card {
        -webkit-backdrop-filter: blur(18px) saturate(1.3);
      }
      .boton-secundario {
        -webkit-backdrop-filter: blur(12px);
      }
      .fcard-texto {
        -webkit-backdrop-filter: blur(5px);
      }
      .orbit-tools-capsula {
        -webkit-backdrop-filter: blur(6px);
      }
      .escena-panel {
        -webkit-backdrop-filter: blur(24px) saturate(160%);
      }
      /* Islas React que usan las utilities de Tailwind: el calendario del bento
         (backdrop-blur-xl + backdrop-saturate-150) y el indicador de pasos del
         proceso (backdrop-blur-sm). --blur-xl = 24px, --blur-sm = 8px. */
      .backdrop-blur-xl.backdrop-saturate-150 {
        -webkit-backdrop-filter: blur(24px) saturate(150%);
      }
      .backdrop-blur-sm {
        -webkit-backdrop-filter: blur(8px);
      }
    </style>
  </head>

  <body>
    <FondoOrbes />
    <a class="skip-link" href="#contenido">Ir al contenido</a>
    <Header />
    <main id="contenido" class="relative z-1">
      <slot />
    </main>
    <Footer />
    <WhatsAppButton contexto={contextoWhatsApp} />

    <script>
      import '../scripts/scroll-suave';
    </script>

    <script>
      // Aparición al hacer scroll, una sola vez. Por defecto se marca cada
      // sección directa de <main> (salvo la primera, sobre el pliegue); los
      // componentes que necesitan control más fino (encabezado y tarjetas
      // por separado, con stagger vía data-retraso) marcan `.revelar` ellos
      // mismos en su propio markup, así que también se observan acá.
      // Se desactiva sola con prefers-reduced-motion (no hay nada que ocultar).
      const reducido = window.matchMedia('(prefers-reduced-motion: reduce)');
      const secciones = document.querySelectorAll<HTMLElement>('main > section:not(:first-child)');
      secciones.forEach((seccion) => seccion.classList.add('revelar'));

      const elementos = document.querySelectorAll<HTMLElement>('.revelar');

      if (!reducido.matches && 'IntersectionObserver' in window) {
        const observador = new IntersectionObserver(
          (entradas) => {
            entradas.forEach((entrada) => {
              if (!entrada.isIntersecting) return;
              entrada.target.classList.add('visible');
              observador.unobserve(entrada.target);
            });
          },
          { rootMargin: '0px 0px -10% 0px', threshold: 0.05 },
        );

        elementos.forEach((el) => observador.observe(el));
      } else {
        elementos.forEach((el) => el.classList.add('visible'));
      }
    </script>
  </body>
</html>
